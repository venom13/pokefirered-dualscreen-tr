Route8_Text_AidanIntro::
    .string "POKéMON'da iyi görünüyorsun ama kimya\n"
    .string "notun nasıl?$"

Route8_Text_AidanDefeat::
    .string "Ay!\n"
    .string "Erime!$"

Route8_Text_AidanPostBattle::
    .string "Okulda bundan daha iyiyim!$"

Route8_Text_StanIntro::
    .string "Pekala!\n"
    .string "Bir oyun oynayalım!$"

Route8_Text_StanDefeat::
    .string "Tüh!\n"
    .string "Yetmedi!$"

Route8_Text_StanPostBattle::
    .string "Bugün işler yolunda gitmedi.$"

Route8_Text_GlennIntro::
    .string "Bilgili olmalısın.\n"
    .string "Bunu kazanmak için strateji gerekir!$"

Route8_Text_GlennDefeat::
    .string "Bu mantıklı değil!$"

Route8_Text_GlennPostBattle::
    .string "Önce GRIMER ile başla…ve…\n"
    .string "…ve…sonra…$"

Route8_Text_PaigeIntro::
    .string "NIDORAN'ı severim, o yüzden onları biriktiririm!$"

Route8_Text_PaigeDefeat::
    .string "Neden?\n"
    .string "Neden??$"

Route8_Text_PaigePostBattle::
    .string "POKéMON büyüyünce çirkinleşiyor!\n"
    .string "Evrimleşmemeliler.$"

Route8_Text_LeslieIntro::
    .string "Okul eğlenceli ama POKéMON da öyle.$"

Route8_Text_LeslieDefeat::
    .string "Okuluma sadık kalmam gerektiğini bana\n"
    .string "açıkça gösterdin.$"

Route8_Text_LesliePostBattle::
    .string "Değişiklik olsun diye biraz temiz hava\n"
    .string "almayı planlıyordum ama…\p"
    .string "SAFFRON'daki kapılar yüzünden burada\n"
    .string "mahsur kaldık.$"

Route8_Text_AndreaIntro::
    .string "MEOWTH çok tatlı, miyav, miyav, miyav!$"

Route8_Text_AndreaDefeat::
    .string "Miyaaaav!$"

Route8_Text_AndreaPostBattle::
    .string "Bence PIDGEY ve RATTATA da tatlı!$"

Route8_Text_MeganIntro::
    .string "Burada böyle dikilirken aptal görünüyor\n"
    .string "olmalıyız.$"

Route8_Text_MeganDefeat::
    .string "Zavallı, tatlı POKéMON'uma bak ne\n"
    .string "yaptın!$"

Route8_Text_MeganPostBattle::
    .string "SAFFRON'un kapı bekçisi geçmemize izin\n"
    .string "vermiyor.\p"
    .string "İşini yaptığını biliyorum ama bence\n"
    .string "kötü biri.$"

Route8_Text_RichIntro::
    .string "Ben başıboş bir oyuncuyum!$"

Route8_Text_RichDefeat::
    .string "Büyük fırsatı kaçırdım!$"

Route8_Text_RichPostBattle::
    .string "Oyun oynamak ve POKéMON fıstık yemek\n"
    .string "gibi! Bir türlü duramıyorum!$"

Route8_Text_JuliaIntro::
    .string "Tatlı, yuvarlak ve tüylü POKéMON\n"
    .string "hangisi?$"

Route8_Text_JuliaDefeat::
    .string "Dur!\p"
    .string "CLEFAIRY'me bu kadar kötü davranma!$"

Route8_Text_JuliaPostBattle::
    .string "CLEFAIRY'nin AY TAŞI'na maruz kalınca\n"
    .string "evrimleştiğini okudum.\p"
    .string "Bunu bir POKéMON DERGİSİ'nde okudum.\n"
    .string "Acaba doğru mu?$"

Route8_Text_UndergroundPathSign::
    .string "YERALTI GEÇİDİ\n"
    .string "CELADON ŞEHRİ - LAVENDER KÖYÜ$"

Route8_Text_EliIntro::
    .string "ELI: İkiz gücü harikadır.\n"
    .string "Biliyor muydun?$"

Route8_Text_EliDefeat::
    .string "ELI: Ama…\n"
    .string "İkiz gücümüzü kullandık…$"

Route8_Text_EliPostBattle::
    .string "ELI: POKéMON'umu ANNE ile yakaladım!$"

Route8_Text_EliNotEnoughMons::
    .string "ELI: İki POKéMON'un yoksa savaşamayız.$"

Route8_Text_AnneIntro::
    .string "ANNE: İkiz gücümüzle seni şoka\n"
    .string "sokacağız!$"

Route8_Text_AnneDefeat::
    .string "ANNE: İkiz gücümüz…$"

Route8_Text_AnnePostBattle::
    .string "ANNE: ELI ile POKéMON yetiştiriyorum.$"

Route8_Text_AnneNotEnoughMons::
    .string "ANNE: Selam, selam! Savaşalım!\n"
    .string "Ama iki POKéMON getir.$"

Route8_Text_RicardoIntro::
    .string "Bisikletim huysuzlanıyor, dostum.$"

Route8_Text_RicardoDefeat::
    .string "Ahh, dostum.\n"
    .string "Hiç havamda değilim.$"

Route8_Text_RicardoPostBattle::
    .string "Tekerleğimin tellerine çimen dolandı,\n"
    .string "dostum.$"

Route8_Text_JarenIntro::
    .string "Yolu aç, yoksa üstünden geçerim!$"

Route8_Text_JarenDefeat::
    .string "Ciddi misin, ufaklık?$"

Route8_Text_JarenPostBattle::
    .string "Sırf bu yüzden kendini çok özel sanma.$"
