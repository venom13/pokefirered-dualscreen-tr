CeruleanCity_House1_Text_AnyInterestInBerries::
    .string "DUT TOZU'ndan çeşit çeşit ilaç\n"
    .string "hazırlarım.\p"
    .string "İyi DUT TOZU ile her türlü ilacı\n"
    .string "yapabilirim.\p"
    .string "Şimdi söyle bakalım, DUTLARA ilgin var\n"
    .string "mı?$"

CeruleanCity_House1_Text_HaveJustTheThing::
    .string "Ah, güzel! O halde sana göre bir şeyim\n"
    .string "var.$"

CeruleanCity_House1_Text_GoCrushBerriesAtDirectCorner::
    .string "POKéMON MERKEZLERİ'nin ikinci katındaki\n"
    .string "DOĞRUDAN KÖŞE'de yeni bir şey var.\p"
    .string "DUT ezmek için Kablosuz Adaptörlü bir\n"
    .string "makine kurmuşlar.\p"
    .string "İşte burada sen devreye giriyorsun.\p"
    .string "Yalnızca sana emanet edebileceğim bir\n"
    .string "ricam var.\p"
    .string "O makineyi kullanarak bana DUT TOZU\n"
    .string "yapar mısın?\p"
    .string "Unutma, makine POKéMON MERKEZLERİ'nin\n"
    .string "DOĞRUDAN KÖŞE'sinde.\p"
    .string "Bana DUT TOZU getirirsen senin için\n"
    .string "ilaç hazırlarım.\p"
    .string "Unutma, DUTLARI ezip DUT TOZU yap ve\n"
    .string "bana getir.$"

CeruleanCity_House1_Text_WhyMustYouLieNoBerries::
    .string "Neden bana yalan söylüyorsun?\p"
    .string "Kaç DUT'un var?\n"
    .string "Bir tane bile yok!$"

CeruleanCity_House1_Text_TakeInterestInAllSortsOfThings::
    .string "DUTLARA ilgin yok mu?\p"
    .string "Genç dostum, her türlü şeye ilgi\n"
    .string "duymak önemlidir.$"

CeruleanCity_House1_Text_HaveYouBroughtBerryPowder::
    .string "Öhöm! Bana DUT TOZU getirdin mi?$"

CeruleanCity_House5_Text_ExchangeWithWhat::
    .string "Neyle değiştirmek istersin?$"

CeruleanCity_House1_Text_YoullExchangeBerryPowderForItem::
    .string "Peki, DUT TOZU'nu bir {STR_VAR_1} ile\n"
    .string "mi değiştireceksin?$"

CeruleanCity_House1_Text_DontHaveEnoughBerryPowder::
    .string "Hı? Yeterli DUT TOZU'n yok.$"

CeruleanCity_House1_Text_TradeMoreBerryPowder::
    .string "Bu gerçekten kaliteli DUT TOZU.\n"
    .string "Mükemmel ilaç olacak.\p"
    .string "Başka bir şey için daha fazla DUT TOZU\n"
    .string "takas etmek ister misin?$"

CeruleanCity_House1_Text_HopeToSeeYouAgain::
    .string "Peki o zaman.\n"
    .string "Umarım yine gelirsin.$"

CeruleanCity_House1_Text_SeeMeIfYoudLikeToTradePowder::
    .string "DUT TOZU'nu takas etmek istersen bana\n"
    .string "gel.$"

