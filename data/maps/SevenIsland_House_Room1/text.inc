SevenIsland_House_Room1_Text_AstoundingBattle::
    .string "Bravo!\p"
    .string "Gerçekten bravo!\n"
    .string "Ne şaşırtıcı bir savaştı!\p"
    .string "Öyle şaşırtıcıydı ki gözlerim hâlâ\n"
    .string "yaşlarla doluyor!\p"
    .string "Ustaca kullanılan tekniklerin hamleleri\n"
    .string "ve savuşturmaları!\p"
    .string "Gücün güçle çarpışması!\p"
    .string "Evet!\n"
    .string "Saf bir ihtişamdı!$"

