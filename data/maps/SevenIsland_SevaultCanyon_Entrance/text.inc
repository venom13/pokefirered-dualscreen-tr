SevenIsland_SevaultCanyon_Entrance_Text_MiahIntro::
    .string "Kyahaha!\n"
    .string "Seni zahmetsizce fiske ile savururum!$"

SevenIsland_SevaultCanyon_Entrance_Text_MiahDefeat::
    .string "Tüh!\n"
    .string "Bana göre fazla güçlü!$"

SevenIsland_SevaultCanyon_Entrance_Text_MiahPostBattle::
    .string "O ne?\n"
    .string "Göründüğüm gibi davranmıyor muyum?\p"
    .string "Heh, bu stratejimin bir parçası!$"

SevenIsland_SevaultCanyon_Entrance_Text_MasonIntro::
    .string "Selam!\n"
    .string "Hayran kulübümün üyesi misin?$"

SevenIsland_SevaultCanyon_Entrance_Text_MasonDefeat::
    .string "Ah, demek hayranım değilsin…\p"
    .string "Eh, bunu değiştirebilirim.\n"
    .string "Sana şarkı söyleyeyim!$"

SevenIsland_SevaultCanyon_Entrance_Text_MasonPostBattle::
    .string "Lalalaa…\n"
    .string "POKéMON'umu çıkarınca,\l"
    .string "kızlar çığlık atar bir anda!$"

SevenIsland_SevaultCanyon_Entrance_Text_NicolasIntro::
    .string "Bu ada çok geniş…\n"
    .string "Burada devriye gezmek kolay değil.$"

SevenIsland_SevaultCanyon_Entrance_Text_NicolasDefeat::
    .string "Hıhı…$"

SevenIsland_SevaultCanyon_Entrance_Text_NicolasPostBattle::
    .string "Şehirlerden gelen senin gibi\n"
    .string "EĞİTMENLER gerçekten güçlü.\p"
    .string "KULE'ye gideceksin, değil mi?$"

SevenIsland_SevaultCanyon_Entrance_Text_MadelineIntro::
    .string "POKéMON'lara kötü davrananları\n"
    .string "cezalandırırım!$"

SevenIsland_SevaultCanyon_Entrance_Text_MadelineDefeat::
    .string "Sorunlu bir EĞİTMEN gibi\n"
    .string "görünmüyorsun.$"

SevenIsland_SevaultCanyon_Entrance_Text_MadelinePostBattle::
    .string "POKéMON'larına nazik davranırsan seni\n"
    .string "anlarlar.$"

SevenIsland_SevaultCanyon_Entrance_Text_EveIntro::
    .string "EVE: JON ile takım olup birlikte\n"
    .string "savaşacağım.$"

SevenIsland_SevaultCanyon_Entrance_Text_EveDefeat::
    .string "EVE: JON ve ben kaybettik.\n"
    .string "Ehehe.$"

SevenIsland_SevaultCanyon_Entrance_Text_EvePostBattle::
    .string "EVE: JON ile daha çok çalışacağım.$"

SevenIsland_SevaultCanyon_Entrance_Text_EveNotEnoughMons::
    .string "EVE: Seninle savaşırken JON ile takım\n"
    .string "olmak istiyorum.\p"
    .string "İki POKéMON ile geri gel, tamam mı?$"

SevenIsland_SevaultCanyon_Entrance_Text_JonIntro::
    .string "JON: EVE ile birlikteyken asla\n"
    .string "kaybetmeyecekmişiz gibi hissediyorum.$"

SevenIsland_SevaultCanyon_Entrance_Text_JonDefeat::
    .string "JON: EVE ile birlikteyken kaybetmişim\n"
    .string "gibi gelmiyor!$"

SevenIsland_SevaultCanyon_Entrance_Text_JonPostBattle::
    .string "JON: EVE ile birlikteyken kazansam da\n"
    .string "kaybetsem de başım dönüyor.\p"
    .string "Sihirli bir şey!$"

SevenIsland_SevaultCanyon_Entrance_Text_JonNotEnoughMons::
    .string "JON: EVE ile birlikte olursa seninle\n"
    .string "savaşmaktan mutluluk duyarım.\p"
    .string "Yani izin verirsen ikiye iki savaş\n"
    .string "yapmak isterim.$"

SevenIsland_SevaultCanyon_Entrance_Text_RouteSign::
    .string "SEVAULT KANYONU GİRİŞİ\p"
    .string "EĞİTMENLERDEN KANYON'daki bitkilere\n"
    .string "zarar vermemeleri rica olunur.$"

