Text_SwordsDanceTeach::
    .string "Buraya pek fazla insan gelmez.\p"
    .string "Burada antrenman yaparsam giderek\n"
    .string "güçleneceğime eminim.\p"
    .string "Evet, giderek daha güçlü…\p"
    .string "Böyle bir hareket öğrenmeye ne dersin?\n"
    .string "KILIÇ DANSI.$"

Text_SwordsDanceDeclined::
    .string "Peki, o da olur.$"

Text_SwordsDanceWhichMon::
    .string "Pekala, hangi POKéMON'a öğreteceğimi\n"
    .string "seç.$"

Text_SwordsDanceTaught::
    .string "Keşke giderek daha da güçlenebilsek,\n"
    .string "değil mi?$"

SevenIsland_Text_IslandSign::
    .string "YEDİNCİ ADA\n"
    .string "Sonsuzluğun Arayış Adası$"

SevenIsland_Text_IslandsMadeInSevenDays::
    .string "Bu adalara yedi tane oldukları için\n"
    .string "SEVII ADALARI denir.\p"
    .string "…En azından gençler buna inanır.\p"
    .string "Aslında bu adalara yedi günde\n"
    .string "yaratıldıkları söylendiği için bu ad\l"
    .string "verilmiştir.$"

SevenIsland_Text_IslandVirtuallyUntouched::
    .string "Bu ada doğal hâliyle neredeyse hiç\n"
    .string "dokunulmadan bırakılmış.\p"
    .string "Bu yüzden etrafında yürüyüş yapmak\n"
    .string "biraz zor olabilir.$"

