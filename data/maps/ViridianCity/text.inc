ViridianCity_Text_CanCarryMonsAnywhere::
    .string "Belindeki o POKé TOPLARI!\n"
    .string "POKéMON'ların var, değil mi?\p"
    .string "POKéMON'ları her zaman, her yerde\n"
    .string "taşıyıp kullanabilmek harika.$"

ViridianCity_Text_GymClosedWonderWhoLeaderIs::
    .string "Bu POKéMON SALONU hep kapalı.\p"
    .string "Acaba LİDER kim?$"

ViridianCity_Text_ViridiansGymLeaderReturned::
    .string "VIRIDIAN SALONU'nun LİDERİ döndü!$"

ViridianCity_Text_WantToKnowAboutCaterpillarMons::
    .string "İki tür tırtıl POKéMON'u öğrenmek ister\n"
    .string "misin?$"

ViridianCity_Text_OhOkayThen::
    .string "Ah, peki o zaman!$"

ViridianCity_Text_ExplainCaterpieWeedle::
    .string "CATERPIE zehirli değildir ama WEEDLE\n"
    .string "zehirlidir.\p"
    .string "POKéMON'larının WEEDLE'ın ZEHİRLİ\n"
    .string "İĞNE'si ile sokulmamasına dikkat et.$"

ViridianCity_Text_GrandpaHasntHadCoffeeYet::
    .string "Ah, Dedeciğim!\n"
    .string "Bu kadar huysuz olma!\p"
    .string "Çok özür dilerim.\n"
    .string "Henüz kahvesini içmedi.$"

ViridianCity_Text_GoShoppingInPewterOccasionally::
    .string "Ara sıra PEWTER ŞEHRİ'ne alışverişe\n"
    .string "giderim.\p"
    .string "Giderken VIRIDIAN ORMANI'ndaki\n"
    .string "dolambaçlı patikayı kullanmam\l"
    .string "gerekiyor.$"

ViridianCity_Text_ThisIsPrivateProperty::
    .string "Buradan geçmeni kesinlikle\n"
    .string "yasaklıyorum!\p"
    .string "Burası özel mülk!$"

ViridianCity_Text_ShowYouHowToCatchMons::
    .string "Evet, kahvemi içtim, işte harekete\n"
    .string "geçmek için ihtiyacım olan buydu!\p"
    .string "Hm?\n"
    .string "Şu elindeki kırmızı kutu ne?\p"
    .string "Ah, demek POKéDEX üzerinde\n"
    .string "çalışıyorsun.\p"
    .string "O zaman sana bir öğüt vereyim.\p"
    .string "Ne zaman bir POKéMON yakalasan,\n"
    .string "POKéDEX verilerini otomatik olarak\l"
    .string "günceller.\p"
    .string "…POKéMON yakalamayı bilmiyor musun?\p"
    .string "O zaman sana göstersem iyi olur!$"

ViridianCity_Text_ThatWasEducationalTakeThis::
    .string "İşte! Şimdi söyle bakalım, öğretici\n"
    .string "değil miydi?\p"
    .string "Al, bunu da al.$"

ViridianCity_Text_WatchThatToLearnBasics::
    .string "Anlamadığın bir şey olursa onu izle.\p"
    .string "Sana POKéMON EĞİTMENİ olmanın\n"
    .string "temellerini öğretecek.$"

ViridianCity_Text_WeakenMonsFirstToCatch::
    .string "Evet, kahvemi içtim, işte harekete\n"
    .string "geçmek için ihtiyacım olan buydu!\p"
    .string "Ama çok sert yaptım.\n"
    .string "Başım ağrıdı…\p"
    .string "Bu arada POKéDEX'ini dolduruyor musun?\p"
    .string "Önce POKéMON'u yakalamaya çalışmadan\n"
    .string "önce zayıflatmaya odaklan.$"

ViridianCity_Text_HowsTeachyTVHelping::
    .string "Evet, kahvemi içtim, işte harekete\n"
    .string "geçmek için ihtiyacım olan buydu!\p"
    .string "Ama çok sert yaptım.\n"
    .string "Başım ağrıdı…\p"
    .string "Bu arada eski EĞİTİCİ TV'm işine\n"
    .string "yarıyor mu?$"

ViridianCity_Text_MyGrandsonOnTheShow::
    .string "Vahaha!\n"
    .string "Programdaki benim torunum!\p"
    .string "Öğreten o olduğuna göre öğrenmen\n"
    .string "kesin.$"

ViridianCity_Text_TooBusyForTeachyTV::
    .string "Hm… EĞİTİCİ TV'ye bile vakit\n"
    .string "ayıramayacak kadar meşgulsün…\p"
    .string "Vakit nakittir, ikisi de boşa\n"
    .string "harcanmamalı…$"

