Route25_Text_JoeyIntro::
    .string "Yerel EĞİTMENLER buraya pratik\n"
    .string "yapmaya gelir.$"

Route25_Text_JoeyDefeat::
    .string "Fena değilsin.$"

Route25_Text_JoeyPostBattle::
    .string "Tüm POKéMON'ların zayıf yanları vardır.\n"
    .string "En güçlülerinin bile.\p"
    .string "Bu yüzden farklı türlerde POKéMON\n"
    .string "yetiştirmek en iyisidir.$"

Route25_Text_DanIntro::
    .string "Babam beni VERMILION ŞEHRİ'ndeki S.S.\n"
    .string "ANNE'de harika bir partiye götürdü.$"

Route25_Text_DanDefeat::
    .string "Kızgın değilim!$"

Route25_Text_DanPostBattle::
    .string "S.S. ANNE'de dünyanın dört bir yanından\n"
    .string "EĞİTMENLER gördüm.$"

Route25_Text_FlintIntro::
    .string "Ben havalı biriyim.\n"
    .string "Kız arkadaşım var!$"

Route25_Text_FlintDefeat::
    .string "Ahh, hay aksi…$"

Route25_Text_FlintPostBattle::
    .string "Neyse.\n"
    .string "Kız arkadaşım beni neşelendirir.$"

Route25_Text_KelseyIntro::
    .string "Selam!\n"
    .string "Erkek arkadaşım çok havalı!$"

Route25_Text_KelseyDefeat::
    .string "Formum pek iyi değil…$"

Route25_Text_KelseyPostBattle::
    .string "Keşke erkek arkadaşım senin kadar iyi\n"
    .string "olsa.$"

Route25_Text_ChadIntro::
    .string "İçimde bir his vardı…\n"
    .string "Seninle savaşmam gerektiğini\l"
    .string "biliyordum!$"

Route25_Text_ChadDefeat::
    .string "Kaybedeceğimi de biliyordum!$"

Route25_Text_ChadPostBattle::
    .string "POKéMON'unun kafası karışırsa onu\n"
    .string "değiştir.\p"
    .string "Bu iyi bir taktik.$"

Route25_Text_HaleyIntro::
    .string "Arkadaşımın bir sürü tatlı POKéMON'u\n"
    .string "var.\l"
    .string "Çok kıskanıyorum!$"

Route25_Text_HaleyDefeat::
    .string "O kadar da kıskanmıyorum!$"

Route25_Text_HaleyPostBattle::
    .string "AY DAĞI'ndan mı geldin?\n"
    .string "Bana bir CLEFAIRY verir misin?$"

Route25_Text_FranklinIntro::
    .string "AY DAĞI'ndan yeni indim ama hâlâ\n"
    .string "depoda benzin var!$"

Route25_Text_FranklinDefeat::
    .string "Çok çalıştın!$"

Route25_Text_FranklinPostBattle::
    .string "Tüh!\n"
    .string "O mağarada bir ZUBAT beni ısırdı.$"

Route25_Text_NobIntro::
    .string "Burundaki bir POKéMANYAK'ın\n"
    .string "koleksiyonunu görmeye gidiyorum.$"

Route25_Text_NobDefeat::
    .string "Beni fena yendin, hem de çok fena!$"

Route25_Text_NobPostBattle::
    .string "POKéMANYAK gerçekten adının hakkını\n"
    .string "veriyor.\p"
    .string "Koleksiyonunda pek çok nadir POKéMON\n"
    .string "türü var.$"

Route25_Text_WayneIntro::
    .string "BILL'i görmeye mi gidiyorsun?\n"
    .string "Önce savaşalım!$"

Route25_Text_WayneDefeat::
    .string "Sen bir şeysin.$"

Route25_Text_WaynePostBattle::
    .string "Aşağıdaki patika CERULEAN ŞEHRİ'ne\n"
    .string "kestirme.$"

Route25_Text_SeaCottageSign::
    .string "DENİZ KULÜBESİ\n"
    .string "BILL burada yaşıyor!$"

Route25_Text_MistyHighHopesAboutThisPlace::
    .string "Bu burun ünlü bir randevu yeri.\p"
    .string "SALON LİDERİ MISTY'nin burayla ilgili\n"
    .string "büyük umutları var.$"

Route25_Text_AreYouHereAlone::
    .string "Merhaba, buraya yalnız mı geldin?\p"
    .string "CERULEAN'ın burnuna geliyorsan… Çift\n"
    .string "olarak gelmelisin.$"

