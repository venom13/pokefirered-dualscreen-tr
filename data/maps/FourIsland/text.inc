FourIsland_Text_IslandSign::
    .string "DÖRDÜNCÜ ADA\n"
    .string "Ilık, Mavi Buzul Adası$"

FourIsland_Text_LoreleiHasReturned::
    .string "LORELEI geri döndü.\p"
    .string "Acaba şehir hayatını çok mu stresli\n"
    .string "buldu?$"

FourIsland_Text_LoreleiMetLaprasAsChild::
    .string "LORELEI geri gitti.\p"
    .string "Yanındaki LAPRAS'ın çocukken tanıştığı\n"
    .string "LAPRAS olduğunu düşünüyorum.\p"
    .string "Sanırım onu BUZUL MAĞARASI'nda\n"
    .string "yakalamıştı.\p"
    .string "Belki o POKéMON o zamandan beri\n"
    .string "yanındadır.$"

FourIsland_Text_RivalAlreadyGotEggBeSmellingYa::
    .string "{RIVAL}: Hey!\n"
    .string "{PLAYER}!\p"
    .string "SEVII ADALARI'nda ne işin var?\p"
    .string "Beni taklit etmeyi bıraksan iyi olur,\n"
    .string "biliyor musun?\p"
    .string "Neyse, ben POKéMON YUMURTAMI aldım\n"
    .string "bile, bu adayla işim bitti.\p"
    .string "Heh, bahse girerim POKéMON\n"
    .string "YUMURTALARINDAN haberin bile yok.\p"
    .string "Böyle giderse ULUSAL POKéDEX'ini asla\n"
    .string "dolduramazsın.\p"
    .string "Bu arada, bu adada ikimizin de tanıdığı\n"
    .string "birini gördüm.\p"
    .string "Merak ediyorsan gidip etrafa bak.\p"
    .string "Benim boşa harcayacak vaktim yok.\p"
    .string "Görüşürüz, ezik!$"

FourIsland_Text_LoreleiHasLotsOfStuffedDolls::
    .string "Ah, buldun beni!\n"
    .string "Lütfen LORELEI'ye söyleme.\p"
    .string "LORELEI'nin bir sürü peluş bebeği\n"
    .string "olduğunu biliyor muydun?\p"
    .string "DÖRDÜNCÜ ADA'ya her dönüşünde\n"
    .string "koleksiyonu büyüyor!$"

FourIsland_Text_MadeSlushieUsingIcefallCaveIce::
    .string "Ooh, buz gibi!\p"
    .string "BUZUL MAĞARASI'nda kazıdığım buzla\n"
    .string "buzlu içecek yaptım.\p"
    .string "Soğuk ve lezzetli!$"

FourIsland_Text_LoreleisHouse::
    .string "LORELEI'NİN EVİ$"

