ThreeIsland_BerryForest_Text_HelpScaryPokemon::
    .string "LOSTELLE: Hıçk… Fırt…\n"
    .string "Ah! Lütfen, yardım et!\p"
    .string "Az önce orada korkunç bir POKéMON\n"
    .string "belirdi.\p"
    .string "Sürekli korkuttu.\n"
    .string "LOSTELLE'i korkuttu.\p"
    .string "Kımıldayamayacak kadar korkuyorum!\n"
    .string "Ama eve gitmek istiyorum…$"

ThreeIsland_BerryForest_Text_HereItComesAgain::
    .string "Ah! Yine geliyor!\n"
    .string "Hayır! Git! Beni korkutuyor!\p"
    .string "Vaaaaaaah!\n"
    .string "Babamı istiyorum!$"

ThreeIsland_BerryForest_Text_ThankYouHaveThis::
    .string "Ohh! Çok korkunçtu!\n"
    .string "Teşekkürler!\p"
    .string "LOSTELLE DUT toplamaya geldi.\p"
    .string "Bunu alabilirsin!$"

ThreeIsland_BerryForest_Text_LetsGoHome::
    .string "Adın ne?\p"
    .string "LOSTELLE korkuyor, babamın evine\n"
    .string "seninle gidebilir miyim?\p"
    .string "Tamam!\n"
    .string "Hadi eve gidelim!$"

ThreeIsland_BerryForest_Text_BerryPouchIsFull::
