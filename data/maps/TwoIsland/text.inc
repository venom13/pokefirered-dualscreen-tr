TwoIsland_Text_IslandSign::
    .string "İKİNCİ ADA\n"
    .string "İki Kişilik Nimet Adası$"

TwoIsland_Text_JoyfulGameCornerSign::
    .string "Zıpla & Kap!\n"
    .string "Neşeli OYUN SALONU$"

TwoIsland_Text_DangerFastCurrent::
    .string "TEHLİKE! HIZLI AKINTI!\n"
    .string "Balık tutmak ve sörf yapmak yasaktır!$"

TwoIsland_Text_WelcomeToShopMerchandiseLimited::
    .string "Ah!\n"
    .string "Merhaba, dükkânıma hoş geldin!\p"
    .string "Daha yeni açıldık.\p"
    .string "Ürünlerimiz sınırlı ama umarım\n"
    .string "ihtiyaçlarını karşılayabiliriz.$"

TwoIsland_Text_AddedMerchandiseForLostelle::
    .string "LOSTELLE'i kurtardığın için ne kadar\n"
    .string "minnettar olduğumu anlatamam.\p"
    .string "Bu başarın sayesinde ÜÇÜNCÜ ADA\n"
    .string "halkının KANTO'lulara karşı tavrı\l"
    .string "değişti.\p"
    .string "Ve görüyorsun, ben de KANTO'luyum.\p"
    .string "ÜÇÜNCÜ ADA halkı ürünlerimi çoğaltmama\n"
    .string "yardım etti.$"

TwoIsland_Text_HopeYouGiveItYourBest::
    .string "Selam! Burada elimden gelenin en\n"
    .string "iyisini yapıyorum.\l"
    .string "Umarım sen de yaparsın, {PLAYER}.$"

TwoIsland_Text_BringingItemsFromDistantLands::
    .string "Ah, merhaba, {PLAYER}!\n"
    .string "Hoş geldin!\p"
    .string "Uzak diyarlardan eşya getirmeye\n"
    .string "başladım.\p"
    .string "Bazı nadir eşyalar da geldi.\n"
    .string "Lütfen bir göz at!$"

TwoIsland_Text_FellowMovedFromCeladonCity::
    .string "Şuradaki adam CELADON ŞEHRİ'nden\n"
    .string "buraya taşındı.\p"
    .string "Küçük kardeşiyle bir dükkân açtı.\p"
    .string "Neyin içine girdiğini bilip bilmediğini\n"
    .string "insan merak ediyor.$"

TwoIsland_Text_ShopkeepersBrotherWorksGameCorner::
    .string "Dükkân sahibinin kardeşi OYUN\n"
    .string "SALONU'nda işe girdi.\p"
    .string "Daha çok ürün alabilmek için para\n"
    .string "biriktirmeye çalışıyor.$"

TwoIsland_Text_BrunoCameToIslandWhileBack::
    .string "Dinle, dinle.\n"
    .string "Biliyor muydun?\p"
    .string "Bir süre önce ADA'ya ünlü bir EĞİTMEN\n"
    .string "geldi.\p"
    .string "ELİT DÖRTLÜ'den biri.\n"
    .string "Adı BRUNO.\p"
    .string "Öfke Şekerlemelerinin hepsinin\n"
    .string "tükendiğini öğrenince hayal kırıklığıyla\l"
    .string "gitti.$"

TwoIsland_Text_BuyRareItemsHere::
    .string "Seçici EĞİTMEN nadir eşyaları buradan\n"
    .string "alması gerektiğini bilir!$"

TwoIsland_Text_OldWomanLivesOutOnCape::
    .string "Burunda bir kulübede yaşayan yaşlı bir\n"
    .string "kadın var.\p"
    .string "POKéMON'lara dikkatle bakar.\n"
    .string "Biraz tedirgin edici.$"

TwoIsland_Text_HaveYouTriedJumpingGame::
    .string "Boing! Boing!\n"
    .string "Zıplama oyununu denedin mi?\p"
    .string "Katılabilen POKéMON'lar…\n"
    .string "Boing!\p"
    .string "Bazıları boing yapar!\p"
    .string "Bazıları da boooooooing!\p"
    .string "Bunu biliyor muydun?\n"
    .string "Boing!$"

