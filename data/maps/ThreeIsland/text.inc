ThreeIsland_Text_IslandSign::
    .string "ÜÇÜNCÜ ADA\n"
    .string "Aile Bağlarının Akraba Adası$"

ThreeIsland_Text_IslandBelongsToUs::
    .string "Yihaa!\p"
    .string "Bugünden itibaren bu ada bizim!$"

ThreeIsland_Text_GoBackToKanto::
    .string "Gürültünüzü ve belanızı buraya\n"
    .string "getirmenize ihtiyacımız yok!\p"
    .string "KANTO'ya geri dönmenizi istiyoruz!$"

ThreeIsland_Text_BossIsOnHisWay::
    .string "Hey, git başka yerde ağla.\n"
    .string "Patronumuz yolda.\p"
    .string "O gelince sana kolay kolay\n"
    .string "unutamayacağın süper bir motor\l"
    .string "gösterisi yapacağız!$"

ThreeIsland_Text_GetOffIslandNow::
    .string "N-ne!? Asla!\n"
    .string "Hemen adadan defolun!$"

ThreeIsland_Text_WhosGonnaMakeMe::
    .string "Kim yaptıracak?$"

ThreeIsland_Text_AreYouBossGoBackToKanto::
    .string "Patron sen misin?\n"
    .string "Hemen KANTO'ya geri dön!$"

ThreeIsland_Text_JustGotHerePal::
    .string "Ha?\p"
    .string "Daha yeni geldim, dostum.\p"
    .string "Bu düşmanca tavır da ne?\n"
    .string "Çok soğuksun!$"

ThreeIsland_Text_FollowersRaisingHavoc::
    .string "Takipçi çeten motorlarıyla ortalığı\n"
    .string "birbirine katıyor.\p"
    .string "Adada bize ne kadar sorun\n"
    .string "çıkardıklarından haberin var mı?$"

ThreeIsland_Text_OughtToBeThankingUs::
    .string "Hayır, dostum, hiç anlamıyorum.\p"
    .string "Şu yere bak.\n"
    .string "Eğlence için ne yapıyorsunuz?\p"
    .string "Bu uykulu köyü canlandırdığımız için\n"
    .string "bize teşekkür etmelisiniz.\p"
    .string "Ama hey, ısrar ediyorsanız bizi\n"
    .string "göndermeyi deneyebilirsiniz.$"

ThreeIsland_Text_YouCowardsToughInPack::
    .string "Grr… Sizi korkaklar…\n"
    .string "Sürü hâlindeyken ne de sertsiniz…$"

ThreeIsland_Text_WannaMakeSomethingOfYourStaring::
    .string "Sen, ne bakıyorsun?\n"
    .string "Kibar olmadığını bilmiyor musun?\p"
    .string "Bir derdin mi var, ne?$"

ThreeIsland_Text_ThatsSmart::
    .string "Akıllıca.\n"
    .string "Buna burnunu sokma.$"

ThreeIsland_Text_Biker1Intro::
    .string "Heh, cesaretini sevdim.\n"
    .string "Bana para kaybedeceksin ama…$"

ThreeIsland_Text_Biker1Defeat::
    .string "Ne…\n"
    .string "Bu çocuk da ne?!$"

ThreeIsland_Text_Biker1PostBattle::
    .string "Ahh, dostum…\n"
    .string "Sakın gülmeye kalkma!$"

ThreeIsland_Text_Biker2Intro::
    .string "Sen KANTO'dan değil misin?\n"
    .string "Bizim tarafımızda olmalısın!$"

ThreeIsland_Text_Biker2Defeat::
    .string "Saçmalamayı kes!$"

ThreeIsland_Text_Biker2PostBattle::
    .string "Senin derdin ne, böyle parlayıp sönmek?\p"
    .string "Hiç havalı değil, dostum!$"

ThreeIsland_Text_Biker3Intro::
    .string "Patronu buraya davet ettik ama sen her\n"
    .string "şeyi berbat ettin!\p"
    .string "Bizi rezil ettin, dostum!$"

ThreeIsland_Text_Biker3Defeat::
    .string "… … …   … … …$"

ThreeIsland_Text_Biker3PostBattle::
    .string "Patron, sana söylüyorum, bu çocuk için\n"
    .string "bir şey yapmalısın!$"

ThreeIsland_Text_PaxtonIntro::
    .string "Seni izliyordum, bence yeterince\n"
    .string "yaptın.\p"
    .string "Nesin sen, onların arkadaşı falan mı?\p"
    .string "O zaman sanırım onların yerine benimle\n"
    .string "savaşacaksın.$"

ThreeIsland_Text_PaxtonDefeat::
    .string "Pekala, yeter!\n"
    .string "İstediğiniz gibi gidiyoruz!\p"
    .string "Bu sıkıcı adayı bir daha görmeyeceğimiz\n"
    .string "için mutluyuz!$"

ThreeIsland_Text_PaxtonPostBattle::
    .string "Hıh! Evet, bu köylülerle takılmaya\n"
    .string "devam et!$"

ThreeIsland_Text_ThankYouOhYourMonGotHurt::
    .string "Teşekkürler! O serseriler başımıza bela\n"
    .string "olmaktan başka bir işe yaramıyordu.\p"
    .string "Ah, bak, POKéMON'ların benim yüzümden\n"
    .string "yaralandı.$"

ThreeIsland_Text_GivenFullRestore::
    .string "{PLAYER} bir TAM ONARIM aldı.$"

ThreeIsland_Text_OhYourBagIsFull::
    .string "Hı?\n"
    .string "ÇANTAN dolu.$"

ThreeIsland_Text_YouveGotImpressiveMons::
    .string "Yanında gerçekten etkileyici\n"
    .string "POKéMON'lar var.$"

ThreeIsland_Text_LostelleWentOffTowardsBondBridge::
    .string "Senin kadar güçlü biri burada yaşasa\n"
    .string "harika olurdu.\p"
    .string "Umarım en azından bir süre burada\n"
    .string "kalırsın.\p"
    .string "…Efendim?\n"
    .string "LOSTELLE'i mi arıyorsun?\p"
    .string "LOSTELLE bir süre önce BAĞ KÖPRÜSÜ'ne\n"
    .string "doğru gitti.$"

ThreeIsland_Text_WouldntWantToSeeBikersHereAgain::
    .string "ÜÇÜNCÜ ADA aslında buradaki adaların\n"
    .string "en kalabalığıdır.\p"
    .string "Yine de daha az uykulu olabilirdi.\p"
    .string "Ama o MOTORCULAR gibi serserileri\n"
    .string "burada bir daha görmek istemem.$"

ThreeIsland_Text_WhenDodouEvolvesGoingToPlayGame::
    .string "DODUO'mu DUT ORMANI'nda eğiteceğim.\p"
    .string "Evrimleşince İKİNCİ ADA'da bir oyun\n"
    .string "oynayacağım.$"

ThreeIsland_Text_Doduo::
    .string "DODUO: Gigiih!$"

