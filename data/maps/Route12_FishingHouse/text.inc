    .string "{STR_VAR_2} inç!\p"
    .string "Balık tutmanın ince, şiirsel yönlerine\n"
    .string "nadir bir takdirin var!\p"
    .string "Bunu almalısın.\n"
    .string "Israr ediyorum!$"

Route12_FishingHouse_Text_LookForwardToGreaterRecords::
    .string "Senden daha büyük rekorlar görmeyi\n"
    .string "dört gözle bekleyeceğim!$"

Route12_FishingHouse_Text_HuhXInchesSameSizeAsLast::
