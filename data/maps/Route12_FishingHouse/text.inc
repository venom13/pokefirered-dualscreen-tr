Route12_FishingHouse_Text_DoYouLikeToFish::
    .string "Ben BALIKÇI GURU'nun küçük kardeşiyim.\p"
    .string "Balık tutmaya bayılırımmm!\n"
    .string "Onsuz yapamam.\p"
    .string "Söyle bakalım, balık tutmayı sever\n"
    .string "misin?$"

Route12_FishingHouse_Text_TakeThisAndFish::
    .string "Harika! Tarzını sevdim.\n"
    .string "Bence arkadaş olabiliriz.\p"
    .string "Bunu al ve balık tut, genç dostum!$"

Route12_FishingHouse_Text_ReceivedSuperRod::
    .string "{PLAYER}, BALIKÇI GURU'nun kardeşinden\n"
    .string "bir SÜPER OLTA aldı.$"

Route12_FishingHouse_Text_IfYouCatchBigMagikarpShowMe::
    .string "Balık tutmak bir yaşam biçimidir!\n"
    .string "En güzel şiir gibidir.\p"
    .string "Denizlerden nehirlere, çık ve büyüğünü\n"
    .string "yakala, dostum.\p"
    .string "Şimdi bir ricam var.\p"
    .string "O OLTA ile büyük bir MAGIKARP\n"
    .string "yakalarsan onu görmek istiyorum.\p"
    .string "Balık tutmayı ne kadar seviyorsam\n"
    .string "devasa MAGIKARP görmeyi de o kadar\l"
    .string "severim.$"

Route12_FishingHouse_Text_OhThatsDisappointing::
    .string "Ah…\n"
    .string "Ne hayal kırıklığı…$"

Route12_FishingHouse_Text_TryFishingBringMeMagikarp::
    .string "Merhaba, {PLAYER}!\n"
    .string "Balık tuttun mu?\p"
    .string "SÜPER OLTA ile her türlü suda balık\n"
    .string "tutmayı dene.\p"
    .string "Farklı yerlerde farklı POKéMON'lar\n"
    .string "bulursun.\p"
    .string "Ah, bana devasa MAGIKARP getirmeyi de\n"
    .string "unutma.$"

Route12_FishingHouse_Text_OhMagikarpAllowMeToSee::
    .string "Hı? {PLAYER}?\n"
    .string "Bu bir MAGIKARP değil mi!\p"
    .string "Hemen göreyim!$"

Route12_FishingHouse_Text_WhoaXInchesTakeThis::
