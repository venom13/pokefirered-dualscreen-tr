VermilionCity_Gym_Text_LtSurgeIntro::
    .string "Hey, evlat! Burada ne yaptığını\n"
    .string "sanıyorsun?\p"
    .string "Savaşta uzun yaşayamazsın!\n"
    .string "O cılız gücünle olmaz!\p"
    .string "Sana söylüyorum evlat, savaşta beni\n"
    .string "elektrikli POKéMON'lar kurtardı!\p"
    .string "Düşmanlarımı çarpıp felç ettiler!\p"
    .string "Sana da aynısını yapacağım!{PLAY_BGM}{MUS_ENCOUNTER_GYM_LEADER}$"

VermilionCity_Gym_Text_LtSurgePostBattle::
    .string "Küçük bir tavsiye, evlat!\p"
    .string "Elektrik gerçekten güçlüdür!\p"
    .string "Ama TOPRAK türü POKéMON'lara karşı işe\n"
    .string "yaramaz!$"

VermilionCity_Gym_Text_ExplainThunderBadgeTakeThis::
    .string "ŞİMŞEK ROZETİ POKéMON'unun HIZINI\n"
    .string "artırır!\p"
    .string "Ayrıca POKéMON'unun istediği an şimşek\n"
    .string "hızında UÇMASINI sağlar, evlat!\p"
    .string "Sen özelsin, evlat!\n"
    .string "Al bunu!$"

VermilionCity_Gym_Text_ReceivedTM34FromLtSurge::
    .string "{PLAYER}, LT. SURGE'den TM34 aldı.$"

VermilionCity_Gym_Text_ExplainTM34::
    .string "TM34'te ŞOK DALGASI var!\p"
    .string "Onu bir ELEKTR POKéMON'una öğret!$"

VermilionCity_Gym_Text_MakeRoomInYourBag::
    .string "Hey, evlat, ÇANTANDA yer aç!$"

VermilionCity_Gym_Text_LtSurgeDefeat::
    .string "İşte bu şok edici!\p"
    .string "Sen gerçeksin, evlat!\p"
    .string "Pekala, al ŞİMŞEK ROZETİ'ni!$"

VermilionCity_Gym_Text_TuckerIntro::
    .string "Ordudayken LT. SURGE benim sert\n"
    .string "komutanımdı.\p"
    .string "Çok zorlu bir amirdi.$"

VermilionCity_Gym_Text_TuckerDefeat::
    .string "Dur!\n"
    .string "Çok iyisin!$"

VermilionCity_Gym_Text_TuckerPostBattle::
    .string "O kapıyı açmak kolay değil.\p"
    .string "LT. SURGE orduda temkinli doğasıyla\n"
    .string "hep ünlüydü.$"

VermilionCity_Gym_Text_BailyIntro::
    .string "Hafif sıkletim ama elektrikte iyiyim!\p"
    .string "Bu yüzden bu SALON'a katıldım.$"

VermilionCity_Gym_Text_BailyDefeat::
    .string "Kızardım!$"

VermilionCity_Gym_Text_BailyPostBattle::
    .string "Tamam, konuşacağım!\p"
    .string "LT. SURGE kapı düğmelerini bir şeylerin\n"
    .string "içine sakladığını söyledi.$"

VermilionCity_Gym_Text_DwayneIntro::
    .string "Burası çocuklara göre değil!\n"
    .string "İyi olsan bile!$"

VermilionCity_Gym_Text_DwayneDefeat::
    .string "Vay!\n"
    .string "Şaşırttın beni!$"

VermilionCity_Gym_Text_DwaynePostBattle::
    .string "SALON'daki tuzakları LT. SURGE bizzat\n"
    .string "kurdu.\p"
    .string "Her yere çift kilit koydu.\n"
    .string "Sana bir ipucu vereyim.\p"
    .string "Birinci kilidi açınca ikinci kilit hemen\n"
    .string "yanındadır.$"

VermilionCity_Gym_Text_GymGuyAdvice::
    .string "Hey!\n"
    .string "Geleceğin şampiyonu!\p"
    .string "LT. SURGE'ün bir lakabı var.\p"
    .string "İnsanlar ona Şimşek Amerikalı der!\p"
    .string "Elektrikli POKéMON uzmanıdır.\p"
    .string "KUŞ/SU türü POKéMON'lar ELEKTR türüne\n"
    .string "karşı zayıftır.\p"
    .string "Felce de dikkat et.\p"
    .string "LT. SURGE çok temkinlidir.\p"
    .string "Kendini içeri kilitledi, ona ulaşmak\n"
    .string "kolay olmayacak.$"

VermilionCity_Gym_Text_GymGuyPostVictory::
    .string "Vay!\n"
    .string "O maç elektrikliydi!$"

VermilionCity_Gym_Text_GymStatue::
    .string "VERMILION POKéMON SALONU\n"
    .string "LİDER: LT. SURGE\p"
    .string "KAZANAN EĞİTMENLER:\n"
    .string "{RIVAL}$"

VermilionCity_Gym_Text_GymStatuePlayerWon::
    .string "VERMILION POKéMON SALONU\n"
    .string "LİDER: LT. SURGE\p"
    .string "KAZANAN EĞİTMENLER:\n"
    .string "{RIVAL}, {PLAYER}$"

VermilionCity_Gym_Text_NopeOnlyTrashHere::
    .string "Hayır!\n"
    .string "Burada sadece çöp var.$"

VermilionCity_Gym_Text_SwitchUnderTrashFirstLockOpened::
    .string "Hey! Çöpün altında bir düğme var! Aç\n"
    .string "onu!\p"
    .string "Birinci elektrik kilidi açıldı!$"

VermilionCity_Gym_Text_AnotherSwitchInTrash::
    .string "ガサゴソ‥！\n"
    .string "おっと！　ゴミばこの　そこに\l"
    .string "また　スイッチが　あった！\l"
    .string "おして　みよう！　‥　ポチッとな$"

VermilionCity_Gym_Text_SecondLockOpened::
    .string "İkinci elektrik kilidi açıldı!\n"
    .string "Motorlu kapı açıldı!$"

VermilionCity_Gym_Text_OnlyTrashLocksWereReset::
    .string "Hayır!\n"
    .string "Burada sadece çöp var.\p"
    .string "Hey!\n"
    .string "Elektrik kilitleri sıfırlandı!$"

