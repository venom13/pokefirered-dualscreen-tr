PokemonLeague_ChampionsRoom_Text_Intro::
    .string "{RIVAL}: Hey, {PLAYER}!\p"
    .string "Seni görmeyi dört gözle bekliyordum,\n"
    .string "{PLAYER}.\p"
    .string "Beni keskin tutması için rakibim güçlü\n"
    .string "olmalı.\p"
    .string "POKéDEX'im üzerinde çalışırken her\n"
    .string "yerde POKéMON aradım.\p"
    .string "Sadece bu da değil, her POKéMON\n"
    .string "türünü yenecek takımlar kurdum.\p"
    .string "Ve şimdi…\p"
    .string "POKéMON LİGİ ŞAMPİYONU benim!\p"
    .string "{PLAYER}!\n"
    .string "Bunun ne anlama geldiğini biliyor\l"
    .string "musun?\p"
    .string "Söyleyeyim.\p"
    .string "Dünyanın en güçlü EĞİTMENİ benim!$"

PokemonLeague_ChampionsRoom_Text_RematchIntro::
    .string "{RIVAL}: Hey, {PLAYER}!\p"
    .string "Geri geldin, {PLAYER}!\n"
    .string "Hahah, bu çok harika!\p"
    .string "Beni keskin tutması için rakibim güçlü\n"
    .string "olmalı.\p"
    .string "POKéDEX'im üzerinde çalışırken her\n"
    .string "yerde POKéMON aradım.\p"
    .string "Sadece bu da değil, her POKéMON\n"
    .string "türünü yenecek takımlar kurdum.\p"
    .string "Ve şimdi…\p"
    .string "POKéMON LİGİ ŞAMPİYONU benim!\p"
    .string "{PLAYER}!\n"
    .string "Bunun ne anlama geldiğini biliyor\l"
    .string "musun?\p"
    .string "Söyleyeyim.\p"
    .string "Dünyanın en güçlü EĞİTMENİ benim!$"

PokemonLeague_ChampionsRoom_Text_Defeat::
    .string "HAYIR!\n"
    .string "Olamaz!\l"
    .string "En iyi hâlimdeyken beni yendin!\p"
    .string "LİG ŞAMPİYONU olmak için onca emekten\n"
    .string "sonra mı?\p"
    .string "Saltanatım şimdiden bitti mi?\n"
    .string "Bu haksızlık!$"

PokemonLeague_ChampionsRoom_Text_Victory::
    .string "はーはッ！\n"
    .string "かった！　かった！　かった！\p"
    .string "{PLAYER}に　まける　ような\n"
    .string "おれさま　では　なーい！\p"
    .string "ま！　ポケモンの\n"
    .string "てんさい　{RIVAL}さま　あいてに\l"
    .string "ここまで　よく　がんばった！\p"
    .string "ほめて　つかわす！\n"
    .string "はーッ！　はーはッはッ！$"

PokemonLeague_ChampionsRoom_Text_PostBattle::
    .string "Neden?\n"
    .string "Neden kaybettim?\p"
    .string "POKéMON'larımı yetiştirirken hiç hata\n"
    .string "yapmadım…\p"
    .string "Lanet olsun! Yeni POKéMON LİGİ\n"
    .string "ŞAMPİYONU sensin!\p"
    .string "Kabul etmekten hoşlanmasam da…$"

PokemonLeague_ChampionsRoom_Text_OakPlayer::
    .string "OAK: {PLAYER}!$"

PokemonLeague_ChampionsRoom_Text_OakCongratulations::
    .string "OAK: Demek kazandın!\n"
    .string "İçtenlikle tebrik ederim!\p"
    .string "Yeni POKéMON LİGİ ŞAMPİYONU sensin!\p"
    .string "POKéDEX üzerinde çalışmak için\n"
    .string "{STR_VAR_1} ile yola çıktığından beri\l"
    .string "çok büyüdün.\p"
    .string "{PLAYER}, artık olgunlaştın!$"

PokemonLeague_ChampionsRoom_Text_OakImDisappointedRival::
    .string "OAK: {RIVAL}…\n"
    .string "Senden hayal kırıklığına uğradım.\p"
    .string "ELİT DÖRTLÜ'yü yendiğini duyunca\n"
    .string "geldim.\p"
    .string "Ama buraya vardığımda çoktan\n"
    .string "kaybetmiştin!\p"
    .string "{RIVAL}, neden kaybettiğini anlıyor\n"
    .string "musun?\p"
    .string "POKéMON'larına sevgi ve güvenle\n"
    .string "davranmayı unuttun.\p"
    .string "Onlar olmadan asla yeniden ŞAMPİYON\n"
    .string "olamazsın!$"

PokemonLeague_ChampionsRoom_Text_OakPlayerComeWithMe::
    .string "OAK: {PLAYER}.\p"
    .string "Zaferinin yalnızca senin eserin\n"
    .string "olmadığını anlıyorsun.\p"
    .string "POKéMON'larınla aranızdaki bağ harika.\p"
    .string "{PLAYER}!\n"
    .string "Benimle gel!$"

