SevenIsland_SevaultCanyon_Text_CyndyIntro::
    .string "Formum zirvede!$"

SevenIsland_SevaultCanyon_Text_CyndyDefeat::
    .string "Hı?\n"
    .string "Bir şeyler ters…$"

SevenIsland_SevaultCanyon_Text_CyndyPostBattle::
    .string "Bu hâlimle EĞİTMEN KULESİ'ni ertelemem\n"
    .string "gerekebilir…$"

SevenIsland_SevaultCanyon_Text_EvanIntro::
    .string "En güçlü POKéMON'lara sahip olman bir\n"
    .string "şey ifade etmez…\p"
    .string "Onları doğru kullanmayı bilmiyorsan\n"
    .string "hiçbir anlamı yok!$"

SevenIsland_SevaultCanyon_Text_EvanDefeat::
    .string "Bu işin ustasısın.$"

SevenIsland_SevaultCanyon_Text_EvanPostBattle::
    .string "Arada bir görürsün, müthiş POKéMON'ları\n"
    .string "olan ama ne yapacağını bilmeyen\l"
    .string "EĞİTMENLERİ.\p"
    .string "POKéMON eğitmeden önce EĞİTMENLERİN\n"
    .string "kendilerinin olgunlaşması gerekir.$"

SevenIsland_SevaultCanyon_Text_JacksonIntro::
    .string "Çevreyi korumak için çalışırım.\n"
    .string "Karşılığında doğa da beni korur!$"

SevenIsland_SevaultCanyon_Text_JacksonDefeat::
    .string "Vay! Güçlüsün!\n"
    .string "Beni korumaya ne dersin?$"

SevenIsland_SevaultCanyon_Text_JacksonPostBattle::
    .string "Yıldızların ötesinden bakınca\n"
    .string "gezegenimiz sadece bir damla su.\p"
    .string "Ama o su damlasını herkes için korumak\n"
    .string "istiyoruz.$"

SevenIsland_SevaultCanyon_Text_KatelynIntro::
    .string "Ayakkabıların epey şık.$"

SevenIsland_SevaultCanyon_Text_KatelynDefeat::
    .string "Tatlı görünüşüne rağmen çok iyisin.$"

SevenIsland_SevaultCanyon_Text_KatelynPostBattle::
    .string "O şık KOŞU AYAKKABISI'nı annen mi aldı?\p"
    .string "Sana bayılıyor olmalı.$"

SevenIsland_SevaultCanyon_Text_LeroyIntro::
    .string "Güçlü görünüyorsun.\n"
    .string "Lütfen seninle savaşayım!$"

SevenIsland_SevaultCanyon_Text_LeroyDefeat::
    .string "Biliyordum!\n"
    .string "Düşündüğüm kadar güçlüsün!$"

SevenIsland_SevaultCanyon_Text_LeroyPostBattle::
    .string "Savaşma şeklin bana çok faydalı veri\n"
    .string "sağladı.\p"
    .string "Çok teşekkürler!$"

SevenIsland_SevaultCanyon_Text_MichelleIntro::
    .string "Bu kadar güçlü olmak için mümkün olan\n"
    .string "en iyi eğitimi aldım.\p"
    .string "Kimseye kaybetmek istemiyorum!$"

SevenIsland_SevaultCanyon_Text_MichelleDefeat::
    .string "Teşekkürler. Sana kaybederek özgür\n"
    .string "kalmışım gibi hissediyorum.$"

SevenIsland_SevaultCanyon_Text_MichellePostBattle::
    .string "Nedense en ufak şeye bile çok\n"
    .string "sinirleniyorum.\p"
    .string "Derin nefes alarak sakinleşeceğim.$"

SevenIsland_SevaultCanyon_Text_LexIntro::
    .string "LEX: Sevgilim NYA, birlikte\n"
    .string "kazanabiliriz!$"

SevenIsland_SevaultCanyon_Text_LexDefeat::
    .string "LEX: Galiba fazla dikkatsiz davrandım…$"

SevenIsland_SevaultCanyon_Text_LexPostBattle::
    .string "LEX: Bence NYA için iyi bir deneyim\n"
    .string "oldu.\p"
    .string "Sana minnettarım.$"

SevenIsland_SevaultCanyon_Text_LexNotEnoughMons::
    .string "LEX: İkimizle aynı anda savaşmanı rica\n"
    .string "edebilir miyim?$"

SevenIsland_SevaultCanyon_Text_NyaIntro::
    .string "NYA: Hocam LEX'i yarı yolda bırakmamak\n"
    .string "için elimden geleni yapacağım!$"

SevenIsland_SevaultCanyon_Text_NyaDefeat::
    .string "NYA: Ah, hayır…\n"
    .string "Çok özür dilerim, ben…$"

SevenIsland_SevaultCanyon_Text_NyaPostBattle::
    .string "NYA: Sanırım LEX'in yanında daha çok\n"
    .string "pişmem ve ders almam gerekecek…\p"
    .string "…Yani LEX, lütfen, böyle yanında\n"
    .string "kalabilir miyim?$"

SevenIsland_SevaultCanyon_Text_NyaNotEnoughMons::
    .string "NYA: Özür dilerim ama ikiye iki\n"
    .string "tarzında savaşabilir miyiz?$"

SevenIsland_SevaultCanyon_Text_RouteSign::
    .string "SEVAULT KANYONU\n"
    .string "İLERİDE TANOBY HARABESİ$"

SevenIsland_SevaultCanyon_Text_BrunoTrainedWithBrawly::
    .string "Tek başına antrenman yapmak kesinlikle\n"
    .string "kötü bir şey değil.\p"
    .string "Ama bir ortakla zirveyi hedeflemek de\n"
    .string "kötü değil.\p"
    .string "BRUNO bile…\n"
    .string "Daha önce BRAWLY adında bir\l"
    .string "arkadaşıyla antrenman yapmış.$"
