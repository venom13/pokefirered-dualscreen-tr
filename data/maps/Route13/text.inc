    .string "Kaybettim!$"

Route13_Text_SusiePostBattle::
    .string "İyi bir EĞİTMEN olmak istiyorum.\n"
    .string "Çok çalışacağım, görürsün.$"

Route13_Text_ValerieIntro::
    .string "Vay!\n"
    .string "ROZETLERİN çok havalı!$"

Route13_Text_ValerieDefeat::
