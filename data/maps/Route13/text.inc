    .string "mi?$"

Route13_Text_SebastianPostBattle::
    .string "POKéMON'larım kaybetseler de mutlu\n"
    .string "görünüyor.$"

Route13_Text_SusieIntro::
    .string "Bir çocuğa göre iyi olduğum söylenir.$"

Route13_Text_SusieDefeat::
