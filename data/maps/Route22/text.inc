Route22_Text_EarlyRivalIntro::
	.string "{RIVAL}: Hey! {PLAYER}!\p"
	.string "POKéMON LİGİ'ne mi gidiyorsun?\n"
	.string "Hiç boşuna uğraşma!\p"
	.string "Muhtemelen hiç ROZETİN yoktur, değil\n"
	.string "mi?\p"
	.string "Onlar olmadan nöbetçi seni geçirmez.\p"
	.string "Bu arada, POKéMON'ların biraz güçlendi\n"
	.string "mi?$"

Route22_Text_EarlyRivalDefeat::
	.string "Ahh!\n"
	.string "Sadece şansın yaver gitti!$"

Route22_Text_EarlyRivalPostBattle::
	.string "POKéMON LİGİ'nin güçlü EĞİTMENLERLE\n"
	.string "kaynadığını duydum.\p"
	.string "Onları nasıl geçeceğimi bulmam lazım.\p"
	.string "Oyalanmayı bırakıp acele etsen iyi\n"
	.string "olur!$"

