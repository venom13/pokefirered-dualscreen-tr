PokemonTower_7F_Text_Grunt1Intro::
    .string "Ne istiyorsun?\n"
    .string "Neden buradasın?$"

PokemonTower_7F_Text_Grunt1Defeat::
    .string "Pes ediyorum!$"

PokemonTower_7F_Text_Grunt1PostBattle::
    .string "Bunu unutmayacağım!$"

PokemonTower_7F_Text_Grunt2Intro::
    .string "Bu yaşlı adam dikine ÜSSÜMÜZE kadar\n"
    .string "yürüdü.\p"
    .string "Sonra ROCKET TAKIMI'nın POKéMON'lara\n"
    .string "nasıl kötü davrandığı hakkında\l"
    .string "söylenmeye başladı.\p"
    .string "Biz de yetişkinler gibi bunu\n"
    .string "konuşuyoruz sadece.$"

PokemonTower_7F_Text_Grunt2Defeat::
    .string "Lütfen!\n"
    .string "Yeter artık!$"

PokemonTower_7F_Text_Grunt2PostBattle::
    .string "POKéMON sadece para kazanmaya yarar.\n"
    .string "Neden kullanmayalım?\p"
    .string "Sen bizim işimize karışma!$"

PokemonTower_7F_Text_Grunt3Intro::
    .string "Kimseyi kurtaramazsın, evlat!$"

PokemonTower_7F_Text_Grunt3Defeat::
    .string "Biz ROCKETLAR'la dövüşme!$"

PokemonTower_7F_Text_Grunt3PostBattle::
    .string "Bunu yanına bırakmayacağız!$"

PokemonTower_7F_Text_MrFujiThankYouFollowMe::
    .string "BAY FUJI: Hı?\n"
    .string "Beni kurtarmaya mı geldin?\p"
    .string "Teşekkürler. Ama buraya kendi isteğimle\n"
    .string "geldim.\p"
    .string "CUBONE'un annesinin ruhunu yatıştırmaya\n"
    .string "geldim.\p"
    .string "Sanırım MAROWAK'ın ruhu sonunda bizi\n"
    .string "terk etti.\p"
    .string "Gösterdiğin ilgi için sana teşekkür\n"
    .string "etmeliyim.\p"
    .string "Beni bu kulenin eteğindeki evime,\n"
    .string "POKéMON EVİ'ne kadar takip et.$"

