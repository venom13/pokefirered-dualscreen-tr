Route19_Text_RichardIntro::
    .string "Yüzmeye çıkmadan önce egzersiz yapıp\n"
    .string "ısınmalıyım.$"

Route19_Text_RichardDefeat::
    .string "Tamamen ısındım!$"

Route19_Text_RichardPostBattle::
    .string "Sağ ol, evlat!\n"
    .string "Yüzmeye hazırım.$"

Route19_Text_ReeceIntro::
    .string "Dur! Yavaşla!\n"
    .string "Kalp krizi geçireceksin!$"

Route19_Text_ReeceDefeat::
    .string "Ooh!\n"
    .string "Buz gibi!$"

Route19_Text_ReecePostBattle::
    .string "TENTACOOL'lara dikkat et.\n"
    .string "Çok acıtarak sokarlar.$"

Route19_Text_MatthewIntro::
    .string "Yüzmeye bayılırım!\n"
    .string "Ya sen?$"

Route19_Text_MatthewDefeat::
    .string "Göbeklama!$"

Route19_Text_MatthewPostBattle::
    .string "Yüzmede deniz POKéMON'larını bile\n"
    .string "yenebilirim.$"

Route19_Text_DouglasIntro::
    .string "Ufkun ötesinde ne var?$"

Route19_Text_DouglasDefeat::
    .string "Glup!$"

Route19_Text_DouglasPostBattle::
    .string "Ötede birkaç ada görüyorum!$"

Route19_Text_DavidIntro::
    .string "POKéMON için dalmayı denedim ama\n"
    .string "olmadı.$"

Route19_Text_DavidDefeat::
    .string "İmdat!$"

Route19_Text_DavidPostBattle::
    .string "Sanırım deniz POKéMON'ları için balık\n"
    .string "tutmak gerekiyor.$"

Route19_Text_TonyIntro::
    .string "Başıma gelen tüm kötü şeyleri unutmak\n"
    .string "için denize bakıyorum.$"

Route19_Text_TonyDefeat::
    .string "Ooh!\n"
    .string "Travmatik!$"

Route19_Text_TonyPostBattle::
    .string "Başıma gelen kötü şeyi unutmak için\n"
    .string "denize bakıyorum!$"

Route19_Text_AnyaIntro::
    .string "Ah, bindiğin şeye bayıldım!\n"
    .string "Kazanırsam onu alabilir miyim?$"

Route19_Text_AnyaDefeat::
    .string "Ah! Kaybettim!$"

Route19_Text_AnyaPostBattle::
    .string "KÖPÜK ADALARI'na daha çok yol var…\p"
    .string "FUCHSIA'ya dönmek istiyorum…$"

Route19_Text_AliceIntro::
    .string "Yüzmek harika!\n"
    .string "Güneş yanığı değil!$"

Route19_Text_AliceDefeat::
    .string "Şok edici!$"

Route19_Text_AlicePostBattle::
    .string "Erkek arkadaşım KÖPÜK ADALARI'na\n"
    .string "yüzmek istedi.$"

Route19_Text_AxleIntro::
    .string "Ahoy!\n"
    .string "Bu sular tehlikeli!$"

Route19_Text_AxleDefeat::
    .string "Ooh!\n"
    .string "Tehlikeli!$"

Route19_Text_AxlePostBattle::
    .string "B-bacaklarım! Kramp girdi!\n"
    .string "Glup, glup…$"

Route19_Text_ConnieIntro::
    .string "Buraya arkadaşlarımla yüzdüm…\n"
    .string "Yoruldum…$"

Route19_Text_ConnieDefeat::
    .string "Bitkinim…$"

Route19_Text_ConniePostBattle::
    .string "Denizde bir POKéMON'a binecek olsam\n"
    .string "LAPRAS isterdim.\p"
    .string "LAPRAS o kadar büyük ki suda beni kuru\n"
    .string "tutar, eminim.$"

Route19_Text_RouteSign::
    .string "DENİZ ROTASI 19\n"
    .string "FUCHSIA ŞEHRİ - KÖPÜK ADALARI$"

Route19_Text_LiaIntro::
    .string "LIA: Kardeşime göz kulak oluyorum.\n"
    .string "Yeni EĞİTMEN oldu.$"

Route19_Text_LiaDefeat::
    .string "LIA: Küçük kardeşime böyle\n"
    .string "davranılmaz!$"

Route19_Text_LiaPostBattle::
    .string "LIA: Küçük bir kardeşin var mı?\p"
    .string "Umarım ona her türlü şeyi\n"
    .string "öğretiyorsundur.$"

Route19_Text_LiaNotEnoughMons::
    .string "LIA: Küçük kardeşimle birlikte savaşmak\n"
    .string "istiyorum.\p"
    .string "İki POKéMON'un yok mu?$"

Route19_Text_LucIntro::
    .string "LUC: Ablam bana yüzmeyi ve POKéMON\n"
    .string "eğitmeyi öğretti.$"

Route19_Text_LucDefeat::
    .string "LUC: Vay be!\n"
    .string "Ablamdan daha güçlü biri!$"

Route19_Text_LucPostBattle::
    .string "LUC: Ablam hem güçlü hem iyi.\n"
    .string "Bence müthiş!$"

Route19_Text_LucNotEnoughMons::
    .string "LUC: Ablamla birlikte seninle\n"
    .string "savaşamayacaksam istemem.\p"
    .string "İki POKéMON'un yok mu?$"
