Route10_PokemonCenter_1F_Text_EveryTypeStrongerThanOthers::
    .string "POKéMON türleri birbirleriyle farklı\n"
    .string "şekilde eşleşir.\p"
    .string "Her tür bazı türlerden güçlü,\n"
    .string "bazılarından zayıftır.$"

Route10_PokemonCenter_1F_Text_NuggetUselessSoldFor5000::
    .string "KÜLÇE tamamen işe yaramaz.\n"
    .string "Bu yüzden onu ¥5000'e sattım.$"

Route10_PokemonCenter_1F_Text_HeardGhostsHauntLavender::
    .string "LAVENDER KÖYÜ'nü hayaletlerin musallat\n"
