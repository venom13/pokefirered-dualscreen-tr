Route10_PokemonCenter_1F_Text_GiveEverstoneIfCaught20Mons::
    .string "Ah… {PLAYER}!\n"
    .string "Seni arıyordum!\p"
    .string "Benim, PROF. OAK'ın her yerde olan\n"
    .string "YARDIMCILARINDAN biri.\p"
    .string "POKéDEX'inde yirmi türün tam verisi\n"
    .string "varsa sana PROF. OAK'tan bir ödül\l"
    .string "vermem gerekiyor.\p"
    .string "Bana bu EVRİMSİZ TAŞ'ı emanet etti.\p"
    .string "Peki {PLAYER}, sana sorayım.\p"
    .string "En az yirmi tür POKéMON'un verisini\n"
    .string "topladın mı?$"

Route10_PokemonCenter_1F_Text_GreatHereYouGo::
    .string "Harika! {STR_VAR_3} tür POKéMON\n"
    .string "yakalamış ya da sahiplenmişsin!\p"
    .string "Tebrikler!\n"
    .string "Buyur!$"

Route10_PokemonCenter_1F_Text_ReceivedEverstoneFromAide::
    .string "{PLAYER}, YARDIMCI'dan EVRİMSİZ TAŞ'ı\n"
    .string "aldı.$"

Route10_PokemonCenter_1F_Text_ExplainEverstone::
    .string "POKéMON'ları evrimleştirmek POKéDEX'e\n"
    .string "kesinlikle katkı sağlar.\p"
    .string "Ama bazen belirli bir POKéMON'un\n"
    .string "evrimleşmesini istemeyebilirsin.\p"
    .string "O durumda EVRİMSİZ TAŞ'ı o POKéMON'a\n"
    .string "ver.\p"
    .string "PROFESÖR'e göre evrimi engelleyecektir.$"

