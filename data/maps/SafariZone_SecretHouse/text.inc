SafariZone_SecretHouse_Text_CongratsYouveWon::
    .string "Ah! Sonunda!\p"
    .string "GİZLİ EV'e ulaşan ilk kişi sensin!\p"
    .string "Açılışımız için bir kampanya\n"
    .string "düzenlemiştim ama…\p"
    .string "Kampanya ödülümüzü kimse kazanmayacak\n"
    .string "diye endişelenmeye başlamıştım.\p"
    .string "Tebrikler!\n"
    .string "Kazandın!$"

SafariZone_SecretHouse_Text_ReceivedHM03FromAttendant::
    .string "{PLAYER}, görevliden GM03 aldı!$"

SafariZone_SecretHouse_Text_ExplainSurf::
    .string "GM03, SÖRF hareketi.\p"
    .string "POKéMON'lar onu kullanarak seni suyun\n"
    .string "karşısına taşıyabilir.\p"
    .string "Ayrıca bu GM tek kullanımlık değil,\n"
    .string "tekrar tekrar kullanabilirsin.\p"
    .string "Bu muhteşem ödülü kazandığın için\n"
    .string "süper şanslısın!$"

SafariZone_SecretHouse_Text_DontHaveRoomForPrize::
    .string "Bu muhteşem ödüle yerin yok!$"

