FiveIsland_ResortGorgeous_House_Text_PleaseHearMyWish::
    .string "SELPHY: Hı?\n"
    .string "Seni bir yerden tanıyor muyum?\p"
    .string "Ah, ama fark etmez.\p"
    .string "Dayanılmaz derecede sıkıldım.\n"
    .string "Lütfen dileğimi dinle.$"

FiveIsland_ResortGorgeous_House_Text_WishToSeeMonPlease::
    .string "Bir POKéMON görmek istiyorum.\n"
    .string "Şirin bir {STR_VAR_1}.\p"
    .string "Hemen bir tane görmek istiyorum.\n"
    .string "Lütfen dileğimi gerçekleştir.$"

FiveIsland_ResortGorgeous_House_Text_OhImTiredOfWaiting::
    .string "SELPHY: Ah, bundan bıktım.\n"
    .string "Seni beklemekten bıktım.\p"
    .string "Bu seferlik affediyorum ama lütfen bir\n"
    .string "dahaki sefere beni hayal kırıklığına\l"
    .string "uğratma.$"

FiveIsland_ResortGorgeous_House_Text_MonYouCaughtForMeThankYou::
    .string "SELPHY: Ah, merhaba.\p"
    .string "Aman tanrım. Bu benim için yakaladığın\n"
    .string "{STR_VAR_1} olmalı.\p"
    .string "Kıkır…\n"
    .string "Sana benziyor.\p"
    .string "Çok naziksin, teşekkürler.\p"
    .string "… …  … …  … …\n"
    .string "Bir sorun mu var?\p"
    .string "Gidebilirsin.\p"
    .string "… …  … …  … …\n"
    .string "Ah, peki. Şimdi anladım.\p"
    .string "SEBASTIAN!\n"
    .string "Hemen buraya gel!$"

FiveIsland_ResortGorgeous_House_Text_ButlerYesMyLady::
    .string "Uşak: Buyurun, hanımım.$"

FiveIsland_ResortGorgeous_House_Text_SelphyGiveTokenOfAppreciation::
    .string "SELPHY: Bu kişiye bir teşekkür hediyesi\n"
    .string "verilmesini sağla.$"

FiveIsland_ResortGorgeous_House_Text_ButlerIShallDoAsYouBid::
    .string "Uşak: Emredersiniz, hanımım.$"

FiveIsland_ResortGorgeous_House_Text_ButlerPleaseAcceptThisAsHerThanks::
    .string "Uşak: SELPHY Hanım'ı memnun ettiğiniz\n"
    .string "için içtenlikle teşekkür ederim.\p"
    .string "Lütfen bunu onun teşekkürü olarak\n"
    .string "kabul edin…$"

FiveIsland_ResortGorgeous_House_Text_ButlerBagAppearsToBeFull::
    .string "Uşak: Ne yazık ki ÇANTANIZ dolu\n"
    .string "görünüyor.$"

FiveIsland_ResortGorgeous_House_Text_OhHowDisappointing::
    .string "Ah…\n"
    .string "Ne hayal kırıklığı.$"

FiveIsland_ResortGorgeous_House_Text_SelphyWishYouBestOfLuck::
    .string "SELPHY: Sana bol şans dilerim.$"

FiveIsland_ResortGorgeous_House_Text_LadySelphySmileHasBrillianceOfSun::
    .string "Uşak: SELPHY Hanım'ın gülümsemesi güneş\n"
    .string "kadar parlaktır.\p"
    .string "Lütfen, yalvarırım SELPHY Hanım'ı mutlu\n"
    .string "edin.$"

