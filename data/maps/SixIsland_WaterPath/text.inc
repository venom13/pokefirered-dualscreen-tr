SixIsland_WaterPath_Text_RoseIntro::
    .string "Hoş bir esintinin beni buraya kadar\n"
    .string "getirmesine izin verdim.$"

SixIsland_WaterPath_Text_RoseDefeat::
    .string "Kıkır… Kararlı olunca çok tatlısın.$"

SixIsland_WaterPath_Text_RosePostBattle::
    .string "Şuradaki ormana gitmek istiyorum ama…\p"
    .string "Bir sürü BÖCEK POKéMON'u var.\n"
    .string "Beni biraz korkutuyorlar.$"

SixIsland_WaterPath_Text_EdwardIntro::
    .string "Kimse görmesin diye gizlice pratik\n"
    .string "yapıyorum.$"

SixIsland_WaterPath_Text_EdwardDefeat::
    .string "Kaybettiğimi kimse görmedi, değil mi?$"

SixIsland_WaterPath_Text_EdwardPostBattle::
    .string "Bir sanatçı olarak harcadığım emeği\n"
    .string "insanların bilmesini istemem.$"

SixIsland_WaterPath_Text_SamirIntro::
    .string "Ne, benim gibi YÜZÜCÜLERİ görmekten\n"
    .string "bıktığını mı söylüyorsun?\p"
    .string "Ahh, nefret etme!$"

SixIsland_WaterPath_Text_SamirDefeat::
    .string "Ah, hayır, hayır, hayır.$"

SixIsland_WaterPath_Text_SamirPostBattle::
    .string "YÜZÜCÜ olma damgasından kurtulamadım…$"

SixIsland_WaterPath_Text_DeniseIntro::
    .string "Erkek arkadaşım hep meşgul, ben de tek\n"
    .string "başıma yüzmeye geliyorum.$"

SixIsland_WaterPath_Text_DeniseDefeat::
    .string "Ahh, bunun olacağını biliyordum!$"

SixIsland_WaterPath_Text_DenisePostBattle::
    .string "Erkek arkadaşımla birlikte olamadığımda\n"
    .string "onun verdiği POKéMON ile vakit\l"
    .string "geçiririm.$"

SixIsland_WaterPath_Text_EarlIntro::
    .string "Söylesene, buralarda dağlar nerede?$"

SixIsland_WaterPath_Text_EarlDefeat::
    .string "Savaşmakla meşgulken yolumu kaybettim!$"

SixIsland_WaterPath_Text_EarlPostBattle::
    .string "Buralarda hiç dağ yok mu?$"

SixIsland_WaterPath_Text_MiuIntro::
    .string "MIU: Merhaba POKéMON!\n"
    .string "Oyun zamanı!$"

SixIsland_WaterPath_Text_MiuDefeat::
    .string "MIU: Ah, hayır!\n"
    .string "Anneciğim!$"

SixIsland_WaterPath_Text_MiuPostBattle::
    .string "MIU: Kaybedince içim çok üzülüyor…$"

SixIsland_WaterPath_Text_MiuNotEnoughMons::
    .string "MIU: MIA ve ben İKİZİZ.\n"
    .string "Birlikte savaşmak istiyoruz.$"

SixIsland_WaterPath_Text_MiaIntro::
    .string "MIA: Merhaba POKéMON!\n"
    .string "Savaş zamanı!$"

SixIsland_WaterPath_Text_MiaDefeat::
    .string "MIA: Çok kötüsün!\n"
    .string "Kazandığın için kötüsün!$"

SixIsland_WaterPath_Text_MiaPostBattle::
    .string "MIA: Ohh…\n"
    .string "Özür dilerim, POKéMON'larım…$"

SixIsland_WaterPath_Text_MiaNotEnoughMons::
    .string "MIA: Ah, sadece bir POKéMON'un mu\n"
    .string "var?\p"
    .string "Yalnız hissetmiyor musun?$"

SixIsland_WaterPath_Text_WantedUltimateHorn::
    .string "Aranıyor!\n"
    .string "En Üstün Boynuz!$"

SixIsland_WaterPath_Text_RouteSign::
    .string "SU YOLU\n"
    .string "HARABE VADİSİ'ne çıkar$"

