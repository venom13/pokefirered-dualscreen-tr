IndigoPlateau_PokemonCenter_1F_Text_GymGuyAdvice::
    .string "Yo!\n"
    .string "Geleceğin şampiyonu!\p"
    .string "POKéMON LİGİ'nde ELİT DÖRTLÜ ile art\n"
    .string "arda karşılaşacaksın.\p"
    .string "Kaybedersen her şeye baştan başlaman\n"
    .string "gerekir!\p"
    .string "İşte bu!\n"
    .string "Haydi, göster kendini!$"

IndigoPlateau_PokemonCenter_1F_Text_FaceEliteFourGoodLuck::
    .string "Bundan sonra ELİT DÖRTLÜ ile tek tek\n"
    .string "karşılaşacaksın.\p"
    .string "Kazanırsan sonraki EĞİTMEN'e bir kapı\n"
    .string "açılır. Bol şans!$"

IndigoPlateau_PokemonCenter_1F_Text_LoreleiIsAbsentClosedForTimeBeing::
    .string "Çok üzgünüm ama buraya gelerek vaktini\n"
    .string "boşa harcadın.\p"
    .string "ELİT DÖRTLÜ'den LORELEI burada değil.\p"
    .string "Bu yüzden POKéMON LİGİ şimdilik\n"
    .string "kapalı.$"

IndigoPlateau_PokemonCenter_1F_Text_AgathaWhuppedUs::
    .string "AGATHA'nın HAYALT türü POKéMON'ları\n"
    .string "korkunç derecede güçlü.\p"
    .string "DÖVÜŞ türü POKéMON'larımı alıp sonuna\n"
    .string "kadar yetiştirdim.\p"
    .string "AGATHA'nın karşısına epey kendimden emin\n"
    .string "çıktım ama bizi pataklayıverdi.\p"
    .string "O yaşlı kadının sigortası da çok çabuk\n"
    .string "atıyor.\p"
    .string "O korkunç kadını bağırtmak için hiçbir\n"
    .string "şey gerekmiyor.$"

IndigoPlateau_PokemonCenter_1F_Text_LancesCousinGymLeaderFarAway::
    .string "Belki de ELİT DÖRTLÜ üyesi olmak\n"
    .string "kandadır.\p"
    .string "Duyduğuma göre LANCE'in çok uzaklarda\n"
    .string "bir yerde SALON LİDERİ olan bir kuzeni\l"
    .string "var.$"

