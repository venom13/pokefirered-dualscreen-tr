Route15_Text_KindraIntro::
    .string "Takasla yeni birkaç POKéMON aldım.\n"
    .string "Onları sende deneyebilir miyim?$"

Route15_Text_KindraDefeat::
    .string "Yetmedi!$"

Route15_Text_KindraPostBattle::
    .string "Takasla aldığın POKéMON'ların lakabını\n"
    .string "değiştiremezsin.\p"
    .string "Lakabı yalnızca Asıl Sahibi\n"
    .string "değiştirebilir.$"

Route15_Text_BeckyIntro::
    .string "Nazik görünüyorsun, bence seni\n"
    .string "yenebilirim.\p"
    .string "Bir deneyeyim!$"

Route15_Text_BeckyDefeat::
    .string "Hayır, yanlış!$"

Route15_Text_BeckyPostBattle::
    .string "MOTORCULARDAN korkuyorum. Çok çirkin\n"
    .string "ve kötü görünüyorlar!$"

Route15_Text_EdwinIntro::
    .string "Islık çalınca kuş POKéMON'larını\n"
    .string "çağırabilirim.$"

Route15_Text_EdwinDefeat::
    .string "Ay!\n"
    .string "Bu bir trajedi!$"

Route15_Text_EdwinPostBattle::
    .string "Belki de savaş için yaratılmamışım.\n"
    .string "Sanırım uygun tip değilim.$"

Route15_Text_ChesterIntro::
    .string "Hmm? Kuşlarım titriyor!\n"
    .string "İyisin, değil mi?$"

Route15_Text_ChesterDefeat::
    .string "Tam düşündüğüm gibi!$"

Route15_Text_ChesterPostBattle::
    .string "Bu çok açık, bilmen gerekir ama…\p"
    .string "DEPREM ve YARIK gibi hareketlerin kuş\n"
    .string "POKéMON'lara etkisi yoktur.$"

Route15_Text_GraceIntro::
    .string "Oh, ne tatlı şeysin!\n"
    .string "Sevimli bir POKéMON gibisin!$"

Route15_Text_GraceDefeat::
    .string "Sen de çok tatlı görünüyordun!$"

Route15_Text_GracePostBattle::
    .string "Seni affediyorum.\n"
    .string "Kaldırabilirim.\l"
    .string "Artık büyük kızım.$"

Route15_Text_OliviaIntro::
    .string "Yalnız yaşadığım için korunmak amacıyla\n"
    .string "POKéMON yetiştiriyorum.$"

Route15_Text_OliviaDefeat::
    .string "Benim için POKéMON kazanmak ya da\n"
    .string "kaybetmekle ilgili değil.$"

Route15_Text_OliviaPostBattle::
    .string "Eve gelince POKéMON'larımın beni\n"
    .string "karşılamasına bayılırım.\p"
    .string "Çok güven verici.$"

Route15_Text_ErnestIntro::
    .string "Hey, ufaklık! Hadi gel!\n"
    .string "Bunları az önce bir ezikten aldım!$"

Route15_Text_ErnestDefeat::
    .string "Neden olmasın?$"

Route15_Text_ErnestPostBattle::
    .string "Hayat çok kısa.\n"
    .string "Kanun kaçağı gibi yaşamak havalı.\l"
    .string "ROCKET TAKIMI KRALDIR!$"

Route15_Text_AlexIntro::
    .string "Bana kaybedince tüm paranı sökül,\n"
    .string "ufaklık!$"

Route15_Text_AlexDefeat::
    .string "Bu doğru olamaz!$"

Route15_Text_AlexPostBattle::
    .string "Para konusunda şaka yapıyordum.\n"
    .string "Beni o kadar ciddiye alma.$"

Route15_Text_CeliaIntro::
    .string "Havalı ve popüler olan ne?\n"
    .string "POKéMON takası!$"

Route15_Text_CeliaDefeat::
    .string "Takas dedim!$"

Route15_Text_CeliaPostBattle::
    .string "Arkadaşlarımla sürekli POKéMON takas\n"
    .string "ederim.$"

Route15_Text_YazminIntro::
    .string "POKéMON'larımla oynamak ister misin?$"

Route15_Text_YazminDefeat::
    .string "Çok sabırsızdım!$"

Route15_Text_YazminPostBattle::
    .string "Gidip daha zayıf insanlarla antrenman yapacağım.$"

Route15_Text_RouteSign::
    .string "ROTA 15\n"
    .string "Batıda FUCHSIA ŞEHRİ$"

Route15_Text_MyaIntro::
    .string "MYA: Tam aradığım kişisin.\n"
    .string "Küçük kardeşimi eğitmeme yardım eder\l"
    .string "misin?$"

Route15_Text_MyaDefeat::
    .string "MYA: RON, odaklanmalısın!\n"
    .string "Yaptığın işe konsantre ol!$"

Route15_Text_MyaPostBattle::
    .string "MYA: Tamam, temposunu artıracağız.\n"
    .string "Antrenman programına ekleme yapacağım!$"

Route15_Text_MyaNotEnoughMons::
    .string "MYA: Bize meydan okumak mı istiyorsun?\n"
    .string "Ama iki POKéMON'a ihtiyacın var.$"

Route15_Text_RonIntro::
    .string "RON: Kaybedince ablam korkutucu\n"
    .string "oluyor.$"

Route15_Text_RonDefeat::
    .string "RON: Ah, hayır, hayır…\n"
    .string "Abla, özür dilerim!$"

Route15_Text_RonPostBattle::
    .string "RON: Of, ıyy…\n"
    .string "Keşke iyi bir ablam olsaydı…$"

Route15_Text_RonNotEnoughMons::
    .string "RON: Ablamla ve benimle savaşmak mı\n"
    .string "istiyordun?\p"
    .string "O zaman iki POKéMON'a ihtiyacın var.$"
