Route12_Text_AndrewDefeat::
    .string "Kaçırdım!$"

Route12_Text_AndrewPostBattle::
    .string "Ne, MAGIKARP mı?\p"
    .string "Onları her zaman yakalarım, tabii.\n"
    .string "Ama ne kadar da güçsüzler.$"

