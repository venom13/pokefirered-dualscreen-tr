PokedexRating_Text_HowIsPokedexComingAlong::
	.string "OAK: Seni görmek güzel!\n"
	.string "POKéDEX'in nasıl gidiyor?\p"
	.string "Ver, bir bakayım.$"

PokedexRating_Text_SeenXOwnedY::
	.string "POKéDEX'inde kaydettiğin ilerleme:\p"
	.string "{STR_VAR_1} POKéMON görüldü ve\n"
	.string "{STR_VAR_2} POKéMON yakalandı.\p"
	.string "{FONT_NORMAL}PROF. OAK'ın değerlendirmesi:$"

PokedexRating_Text_LessThan10::
	.string "Daha yapacak çok işin var.\p"
	.string "Gördüğün her çimenliğe gir ve POKéMON\n"
	.string "ara!$"

PokedexRating_Text_LessThan20::
	.string "Doğru yolda gibisin!\p"
	.string "YARDIMCILARIMDAN birine FLAŞ GM'si\n"
	.string "verdim. Gidip almayı unutma!$"

PokedexRating_Text_LessThan30::
	.string "POKéDEX'in hâlâ biraz daha dolabilir!\p"
	.string "Başka POKéMON türleri yakalamaya\n"
	.string "çalış!$"

PokedexRating_Text_LessThan40::
	.string "Güzel, çok çabaladığın belli!\p"
	.string "YARDIMCILARIMDAN birine EŞYA BULUCU\n"
	.string "verdim. Almayı unutma!$"

PokedexRating_Text_LessThan50::
	.string "POKéDEX'in epey iyi gidiyor!\p"
	.string "YARDIMCILARIMDAN birine TILSIMLI PARA\n"
	.string "verdim. Almayı unutma!$"

PokedexRating_Text_LessThan60::
	.string "Ah, sonunda 50 türü geçtin!\p"
	.string "YARDIMCILARIMDAN birine TP PAYLAŞIM\n"
	.string "verdim. Gidip almayı unutma!$"

PokedexRating_Text_LessThan70::
	.string "Hoho! Bu epey saygın bir POKéDEX\n"
	.string "olmaya başladı!$"

PokedexRating_Text_LessThan80::
	.string "Çok güzel!\p"
	.string "Balık tutarak daha da fazla POKéMON\n"
	.string "toplayacağını düşünüyorum!$"

PokedexRating_Text_LessThan90::
	.string "Harika! Tahmin edeyim… Bir şeyler\n"
	.string "biriktirmeyi seviyorsun, değil mi?$"

PokedexRating_Text_LessThan100::
	.string "Etkilendim!\n"
	.string "Bunu yapmak zor olmuş olmalı!$"

PokedexRating_Text_LessThan110::
	.string "Sonunda 100 türe ulaştın!\n"
	.string "Ne kadar iyi olduğuna inanamıyorum!$"

PokedexRating_Text_LessThan120::
	.string "POKéMON'ların evrimleşmiş hâlleri bile\n"
	.string "sende var! Süper!$"

PokedexRating_Text_LessThan130::
	.string "Mükemmel! Daha fazlası için\n"
	.string "arkadaşlarınla takas yap!$"

PokedexRating_Text_LessThan140::
	.string "Olağanüstü!\n"
	.string "Bu işte gerçek bir profesyonel oldun!$"

PokedexRating_Text_LessThan150::
	.string "Söyleyecek bir şeyim kalmadı!\n"
	.string "Artık POKéMON PROFESÖRÜ sensin!$"

PokedexRating_Text_Complete::
	.string "POKéDEX'in tamamen eksiksiz!\n"
	.string "Tebrikler!!$"

PokedexRating_Text_NationalDexSeenXOwnedY::
	.string "ULUSAL POKéDEX'in ise:\p"
	.string "{STR_VAR_1} POKéMON görüldü ve\n"
	.string "{STR_VAR_2} POKéMON yakalandı.$"

PokedexRating_Text_LookForwardToFilledNationalDex::
	.string "ULUSAL POKéDEX'i doldurduğunu görmeyi\n"
	.string "dört gözle bekleyeceğim!$"

PokedexRating_Text_YouveCompletedDex::
	.string "Sonunda…\p"
	.string "Sonunda POKéDEX'i tamamladın!\p"
	.string "Muhteşem!\n"
	.string "Gerçekten harika bir başarı!$"

PokedexRating_Text_Wroooaaarrr::
	.string "Vuooooooaaaaaarrrr!$"

PokedexRating_Text_HaHa::
	.string "はあ はあ‥$"

PokedexRating_Text_ThankYouMadeDreamReality::
	.string "Teşekkürler, {PLAYER}!\n"
	.string "İçtenlikle teşekkür ederim!\l"
	.string "Hayalimi gerçeğe dönüştürdün!$"

PokedexRating_Text_LoveSeeingYourPokedex::
	.string "OAK: Ah, hoş geldin!\p"
	.string "Söyle bakalım, POKéDEX'in nasıl\n"
	.string "gidiyor?\p"
	.string "Vahaha!\p"
	.string "Aslında nasıl olduğunu biliyorum ama\n"
	.string "yine de görmeyi seviyorum!\p"
	.string "Bakalım…$"
