Help_Text_DescTheHelpSystem::
	.string "Yardım mesajları oyunda ne kadar\n"
	.string "ilerlediğine göre değişir. İhtiyacın\l"
	.string "olduğunda sana destek olmak için\l"
	.string "tasarlanmıştır. Anlamadığın bir şey\l"
	.string "olursa lütfen YARDIM Sistemi'ne bak!$"

Help_Text_DescTheGame::
	.string "POKéMON dünyasını keşfeden ana karakter\n"
	.string "sen oluyorsun! İnsanlarla konuşup\l"
	.string "gizemleri çözdükçe önünde yeni yollar\l"
	.string "açılacak. Harika POKéMON'larınla birlikte\l"
	.string "hedefe doğru çabala!$"

Help_Text_DescWirelessAdapter::
	.string "Bu oyun Kablosuz Adaptör ile kablosuz\n"
	.string "bağlantı üzerinden iletişim kurar.\p"
	.string "Her yerde, her zaman, herkesle\n"
	.string "kablosuz oyna!\p"
	.string "Kablosuz Adaptör hep takılıyken\n"
	.string "oynamayı dene!$"

Help_Text_DescGameFundamentals1::
	.string "En büyük POKéMON EĞİTMENİ olmak için\n"
	.string "her şehri ve kasabayı ziyaret et, her\l"
	.string "yolda yolculuk et, her mağarayı keşfet\l"
	.string "ve her meydan okumayla yüzleş!$"

Help_Text_DescGameFundamentals2::
	.string "Maceranda pek çok engelle\n"
	.string "karşılaşacaksın. Her engel bir şey\l"
	.string "yaparak ya da gizemleri çözerek\l"
	.string "aşılabilir. Bazı engeller çok uzakta\l"
	.string "olan bir şeyden etkilenir.$"

Help_Text_DescGameFundamentals3::
	.string "Yolundaki bazı engeller, POKéMON'ların\n"
	.string "belirli hareketleri öğrenince\l"
	.string "kaldırılabilir.$"

Help_Text_DescWhatArePokemon::
	.string "POKéMON'lar gizemle örtülü harika\n"
	.string "yaratıklardır. Onlarla dünyanın her\l"
	.string "yerinde… uzun çimenlerde, mağaralarda,\l"
	.string "denizde ve başka yerlerde\l"
	.string "karşılaşabilirsin. Onları yakalayan\l"
	.string "EĞİTMENLERE itaat etmeye başlıyor gibi\l"
	.string "görünürler.$"

