Help_Text_DefineHP::
	.string "HP, POKéMON'un canlılığını gösterir.\n"
	.string "POKéMON'un HP'si sıfıra inerse bayılır ve\l"
	.string "savaşamaz. Yani savaşta anahtar, rakibin\l"
	.string "HP'sini sıfıra indirmeye çalışmaktır.\l"
	.string "POKéMON'ların yaralıysa HP'lerini\l"
	.string "POKéMON MERKEZİ'nde ya da eşya\l"
	.string "kullanarak yenile.$"

Help_Text_DefineEXP::
	.string "TP, “Tecrübe Puanı” demektir.\n"
	.string "POKéMON'lar kazanılan savaşlara\l"
	.string "katılarak TP kazanır. Yeterince TP\l"
	.string "biriktiren POKéMON seviye atlar. TP\l"
	.string "Çubuğu biriken TP'yi gösterir. Seviye\l"
	.string "atlayınca sıfırlanır.$"

Help_Text_DefineMoves::
	.string "POKéMON'lar en fazla dört farklı\n"
	.string "hareket öğrenebilir. Saldırılar ve özel\l"
	.string "etkili hareketler dahil çok çeşitli\l"
	.string "hareketler vardır. Öğrenilebilen\l"
	.string "hareketler her POKéMON için farklıdır.\l"
	.string "Bazı hareketler eşyalardan\l"
	.string "öğrenilebilir.$"

Help_Text_DefineAttack::
	.string "SALDIRI, saldırı hareketinin gücünü\n"
	.string "gösterir. Bu değer ne kadar yüksekse\l"
	.string "hareket o kadar güçlüdür. Şu hareket\l"
	.string "türlerinde geçerlidir: NORMAL, ZEHİR,\l"
	.string "TOPRAK, UÇAN, BÖCEK, DÖVÜŞ, KAYA,\l"
	.string "HAYALT ve ÇELİK.$"

Help_Text_DefineDefense::
	.string "SAVUNMA, POKéMON'un fiziksel saldırılara\n"
	.string "karşı direncini gösterir. Bu değer ne\l"
	.string "kadar yüksekse rakibin fiziksel\l"
	.string "vuruşundan o kadar az hasar alınır.$"

Help_Text_DefineSpAtk::
	.string "Ö.SALD (Özel Saldırı), özel saldırı\n"
	.string "hareketinin gücünü gösterir. Bu değer\l"
	.string "ne kadar yüksekse özel saldırı o kadar\l"
	.string "güçlüdür. Şu hareket türlerinde\l"
	.string "geçerlidir: ATEŞ, SU, ELEKTR, ÇİMEN,\l"
	.string "BUZ, PSİŞİK, EJDER ve KARA.$"

Help_Text_DefineSpDef::
	.string "Ö.SAV (Özel Savunma), POKéMON'un özel\n"
	.string "saldırılara karşı direncini gösterir. Bu\l"
	.string "değer ne kadar yüksekse rakibin özel\l"
	.string "saldırısından o kadar az hasar alınır.$"

Help_Text_DefineSpeed::
	.string "HIZ, POKéMON'un çevikliğini gösterir.\n"
	.string "Savaşta bu değer rakibinkini geçerse\l"
	.string "POKéMON daha yavaş rakibinden önce\l"
	.string "hareket edebilir.$"

Help_Text_DefineLevel::
	.string "Sv. (Seviye), POKéMON'un gelişimini ve\n"
	.string "gücünü gösterir. Genellikle POKéMON\l"
	.string "seviye atlayınca HP, SALDIRI ve\l"
	.string "SAVUNMA gibi değerleri artar ve\l"
	.string "güçlenir. POKéMON seviye atlayınca yeni\l"
	.string "bir hareket öğrenebilir.$"

Help_Text_DefineType::
	.string "POKéMON'lar ve hareketler türlere göre\n"
	.string "sınıflandırılır. Her türün diğer türlere\l"
	.string "karşı avantajlı ve dezavantajlı\l"
	.string "eşleşmeleri vardır. Örneğin\l"
	.string "taş-kâğıt-makas gibi, SU türü ATEŞ\l"
	.string "türüne karşı güçlü, ÇİMEN türüne karşı\l"
	.string "zayıftır.$"

Help_Text_DefineOT::
	.string "AS.EĞT “Asıl EĞİTMEN” demektir; seçili\n"
	.string "POKéMON'u ilk yakalayan EĞİTMEN'dir.\l"
	.string "POKéMON takas edilse bile AS.EĞT adı\l"
	.string "değişmez.$"

Help_Text_DefineItem::
	.string "Tüm POKéMON'lara birer eşya\n"
	.string "tutturulabilir. Bazı eşyaları POKéMON\l"
	.string "belli durumlarda otomatik kullanır.\l"
	.string "POKéMON'a eşya tutturmak için ÇANTA'dan\l"
	.string "eşyayı seç ve POKéMON'a “VER”.$"

Help_Text_DefineAbility::
	.string "Tüm POKéMON'ların özel bir YETENEĞİ\n"
	.string "vardır. Bazıları savaşta, bazıları başka\l"
	.string "yerlerde kullanılan pek çok farklı\l"
	.string "yetenek vardır. Yetenekler türden türe\l"
	.string "değişir. Bazı türlerin birden fazla\l"
	.string "yeteneği olabilir.$"

Help_Text_DefineMoney::
	.string "Bir EĞİTMENE karşı savaş kazandığında\n"
	.string "ödül parası alırsın. POKéMON\l"
	.string "MARKETLERİ'nde alışverişin keyfini\l"
	.string "çıkarmak için ödül paranı biriktir!$"

Help_Text_DefineMoveType::
	.string "Hareketler de türlere göre\n"
	.string "sınıflandırılır. Bir türdeki POKéMON aynı\l"
	.string "türden bir hareket kullanırsa hareketin\l"
	.string "gücü artar. Hareketin türü hedefe karşı\l"
	.string "avantajlıysa etkisi de artar.$"

Help_Text_DefineNature::
	.string "Tüm POKéMON'ların bir kişiliği, yani\n"
	.string "“DOĞASI” vardır. POKéMON'un doğası\l"
	.string "seviye atladıkça nasıl gelişeceğini\l"
	.string "etkiliyor gibi görünür.$"

Help_Text_DefineIDNo::
	.string "Kimlik No., EĞİTMEN olarak sana özel\n"
	.string "atanmış bir numaradır. Kimlik No.,\l"
	.string "AS.EĞT adıyla birlikte Asıl EĞİTMENİ\l"
	.string "kesin olarak belirlemek için kullanılır.\l"
	.string "POKéMON takas edilse bile Kimlik No.\l"
	.string "değişmez.$"

Help_Text_DefinePP::
	.string "PP, “Güç Puanı” demektir. Bir hareketin\n"
	.string "savaşta kaç kez kullanılabileceğini\l"
	.string "gösterir. HP gibi PP de POKéMON\l"
	.string "MERKEZİ'ne giderek ya da bazı eşyalarla\l"
	.string "yenilenebilir.$"

Help_Text_DefinePower::
	.string "GÜÇ, saldırının şiddetini gösterir. Bu\n"
	.string "sayı ne kadar yüksekse rakibe\l"
	.string "verilebilecek hasar o kadar büyük olur!$"

Help_Text_DefineAccuracy::
	.string "İSABET, hareketin rakibe isabet etme\n"
	.string "olasılığını gösterir. Bu sayı ne kadar\l"
	.string "yüksekse hareketin hedefi vurma ihtimali\l"
	.string "o kadar artar.$"

Help_Text_DefineFNT::
	.string "BYL “bayıldı” demektir. HP'si sıfıra inen\n"
	.string "POKéMON bayılır. Artık savaşa katılamaz.\l"
	.string "Bayılmış POKéMON'u POKéMON MERKEZİ'nde\l"
	.string "ya da eşya kullanarak iyileştir.$"

Help_Text_DefineItems::
	.string "POKéMON MARKET'ten alınan sıradan\n"
	.string "eşyalar EŞYALAR CEBİ'ne konur. Eşyalar\l"
	.string "kullanılabilir, POKéMON'a tutturulabilir\l"
	.string "ya da çöp olarak atılabilir.$"

Help_Text_DefineKeyItems::
	.string "Bulduğun ya da insanlardan aldığın\n"
	.string "önemli eşyalar ÖNEMLİ EŞYA CEBİ'ne\l"
	.string "konur. Önemli eşyalar kullanılabilir ya\l"
	.string "da SELECT ile hemen kullanmak için\l"
	.string "kaydedilebilir. Kaydedilen eşya MENÜ ve\l"
	.string "ÇANTA açılmadan kullanılabilir.$"

Help_Text_DefinePokeBalls::
	.string "Vahşi POKéMON yakalamak için kullanılan\n"
	.string "POKé TOPLARI, POKé TOPLARI CEBİ'ne\l"
	.string "konur. POKé TOPLARI POKéMON\l"
	.string "MARKETLERİ'nden alınabilir.\l"
	.string "Kullanılabilir, POKéMON'a tutturulabilir\l"
	.string "ya da çöp olarak atılabilir.$"

Help_Text_DefinePokedex::
	.string "POKéDEX'i doldurmak için yakaladığın\n"
	.string "ve/veya evrimleştirdiğin POKéMON\l"
	.string "türlerinin sayısını gösterir. Her çeşit\l"
	.string "POKéMON'u yakalamak için çok çalış!$"

Help_Text_DefinePlayTime::
	.string "Bu oyunu oynadığın toplam süredir.$"

Help_Text_DefineBadges::
	.string "Kazandığın POKéMON LİGİ ROZETLERİ\n"
	.string "kaydedilip gösterilir. Çeşitli şehir ve\l"
	.string "kasabalardaki SALON LİDERLERİ'ni\l"
	.string "yenerek ROZET kazan.$"

Help_Text_DefineTextSpeed::
	.string "Metnin ne kadar hızlı gösterileceğini\n"
	.string "ayarlayabilirsin. Birini seç: YAVAŞ,\l"
	.string "ORTA ya da HIZLI.$"

Help_Text_DefineBattleScene::
	.string "Savaş animasyonunu AÇIK ya da KAPALI\n"
	.string "yapabilirsin.$"

Help_Text_DefineBattleStyle::
	.string "Bir EĞİTMENİN rakibini bayılttıktan\n"
	.string "sonra POKéMON değiştirip\l"
	.string "değiştiremeyeceğini seçebilirsin. Rakibini\l"
	.string "bayılttıktan sonra POKéMON değiştirme\l"
	.string "şansı istiyorsan “DEĞİŞ”e ayarla.$"

Help_Text_DefineSound::
	.string "MONO ve STEREO ses çıkışı arasında\n"
	.string "seçim yapabilirsin.$"

Help_Text_DefineButtonMode::
	.string "L ya da R Düğmesine basarak yardım\n"
	.string "mesajlarını göstermek için “YARDIM”a\l"
	.string "ayarla. POKéDEX sayfaları ve ÇANTA\l"
	.string "CEPLERİ arasında L ve R Düğmeleriyle\l"
	.string "geçiş için “LR”ye ayarla. L Düğmesinin\l"
	.string "A Düğmesi gibi çalışması için “L=A”ya\l"
	.string "ayarla.$"

Help_Text_DefineFrame::
	.string "Bazı menülerin etrafındaki çerçevenin\n"
	.string "tasarımını seçebilirsin. Dene ve\l"
	.string "beğendiğini gör.$"

Help_Text_DefineCancel2::
	.string "Ayarlar kırmızıyla gösterilen seçimlere\n"
	.string "değiştirilir ve MENÜ'ye dönersin.$"

Help_Text_DefineTM::
	.string "TM (Teknik Makine), POKéMON'a hareket\n"
	.string "öğretmek için kullanılan bir cihazdır.\l"
	.string "Pek çok çeşidi vardır. Hareketler\l"
	.string "sadece onları kullanabilen POKéMON'lara\l"
	.string "öğretilebilir. TM bir kullanımdan sonra\l"
	.string "bozulur.$"

Help_Text_DefineHM::
	.string "GM (Gizli Makine), POKéMON'a GİZLİ\n"
	.string "hareket öğretmek için kullanılan bir\l"
	.string "cihazdır. GİZLİ hareket sadece onu\l"
	.string "kullanabilen POKéMON'lara öğretilebilir.\l"
	.string "TM'nin aksine GM tekrar tekrar\l"
	.string "kullanılabilir. GİZLİ hareketi POKéMON\l"
	.string "zor unutur.$"

Help_Text_DefineHMMove::
	.string "GİZLİ hareketler, maceran için\n"
	.string "özellikle önemli olan hareketlerdir.\l"
	.string "Böyle bir hareketi savaş dışında\l"
	.string "kullanmak için “POKéMON” MENÜSÜ'nü aç\l"
	.string "ve hareketi bilen POKéMON'a kullandır.\l"
	.string "Bayılmış bir POKéMON da savaş dışında\l"
	.string "GİZLİ hareket kullanabilir.$"

Help_Text_DefineEvolution::
	.string "Bazı POKéMON'lar belli seviyelere\n"
	.string "gelince büyük bir değişim (evrim)\l"
	.string "geçirir. Evrim, POKéMON'un biçimini ve\l"
	.string "adını, belki de öğrenebileceği\l"
	.string "hareketleri değiştirir. Bazı POKéMON'lar\l"
	.string "seviye atlama dışındaki sebeplerle\l"
	.string "evrimleşir.$"

Help_Text_DefineStatusProblem::
	.string "Durum sorunları:\n"
	.string "Uyku: Hareket kullanamaz.\l"
	.string "Zehir: Sürekli HP kaybettirir.\l"
	.string "Felç: Hareketi engelleyebilir.\l"
	.string "Yanık: HP kaybı, SALDIRI düşer.\l"
	.string "Donma: Hareket kullanamaz.\l"
	.string "Bunlar eşya vb. ile iyileştirilebilir.$"

Help_Text_DefinePokemon::
	.string "POKéMON, bu dünyanın her köşesinde\n"
	.string "yaşayan harika yaratıklara verilen\l"
	.string "isimdir. İnsanlar POKéMON'ları evcil\l"
	.string "hayvan olarak besler, savaşta kullanır\l"
	.string "ve benzeri.$"

Help_Text_DefineIDNo2::
	.string "Kimlik No., EĞİTMEN olarak sana özel\n"
	.string "atanmış bir numaradır. Kimlik No.,\l"
	.string "AS.EĞT adıyla birlikte Asıl EĞİTMENİ\l"
	.string "kesin olarak belirlemek için kullanılır.\l"
	.string "POKéMON takas edilse bile Kimlik No.\l"
	.string "değişmez.$"

Help_Text_DefineMoney2::
	.string "Bir EĞİTMENE karşı savaş kazandığında\n"
	.string "ödül parası alırsın. POKéMON\l"
	.string "MARKETLERİ'nde alışverişin keyfini\l"
	.string "çıkarmak için ödül paranı biriktir!$"

Help_Text_DefineBadges2::
	.string "Kazandığın POKéMON LİGİ ROZETİ sayısını\n"
	.string "gösterir. Çeşitli şehir ve kasabalardaki\l"
	.string "SALON LİDERLERİ'ni yenerek ROZET\l"
	.string "kazan.$"

Help_Text_TheHelpSystem::
