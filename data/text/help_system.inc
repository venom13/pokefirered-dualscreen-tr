Help_Text_AnswerPlayingForFirstTime::
	.string "POKéMON dünyasını keşfeden ana karakter\n"
	.string "sen oluyorsun. İnsanlarla konuşup\l"
	.string "gizemleri çözdükçe önünde yeni yollar\l"
	.string "açılacak. Harika POKéMON'larınla birlikte\l"
	.string "hedefe doğru çabala.$"

Help_Text_AnswerWhatShouldIBeDoing::
	.string "Başka biriyle karşılaşınca yanına git ve\n"
	.string "A Düğmesine bas. Böylece karakterinle\l"
	.string "konuşup etkileşime geçer. Çeşitli eşya\l"
	.string "ve nesneleri de aynı şekilde\l"
	.string "inceleyebilirsin. Bilgi edinmek için sık\l"
	.string "sık insanlarla konuş ve etrafı incele.$"

Help_Text_AnswerCantGetOutOfRoom::
	.string "Bir binanın merdivenlerinde ya da\n"
	.string "çıkışlarında kırmızı bir paspas vardır.\l"
	.string "Karakterini kırmızı paspasın üstüne\l"
	.string "getir. İlerlemek için {PLUS} Yön Tuşu'na\l"
	.string "merdiven ya da çıkış yönünde bas.$"

Help_Text_AnswerCantFindPersonIWant::
	.string "Bu, çok fazla dert etmen gereken bir\n"
	.string "şey değil. Başka insanlarla konuş,\l"
	.string "tabelalara bak, etrafı incele ve\l"
	.string "benzeri şeyler yap. Bazen sadece yeni\l"
	.string "bir kasabaya ya da yere gitmen\l"
	.string "gerekebilir.$"

Help_Text_AnswerTalkedToEveryoneNowWhat::
	.string "Yeni bir yola, kasabaya ya da yere\n"
	.string "gitmeyi dene.$"

Help_Text_AnswerSomeoneBlockingMyWay::
	.string "Bunun sebebi kasabada ya da bir binanın\n"
	.string "içinde bir şey olabilir. Bölgedeki\l"
	.string "insanlarla tekrar konuşmayı dene.\l"
	.string "Çözülmesi gereken bir sorunları varsa\l"
	.string "yardım etmen gerekebilir. Ardından\l"
	.string "yolunu kesen kişiyle tekrar konuşmayı\l"
	.string "dene.$"

Help_Text_AnswerICantGoOn::
	.string "İnsanların yanına gidip A Düğmesine\n"
	.string "basarak konuşmayı dene. Ayrıca tuhaf\l"
	.string "ağaçlar ve garip kayalar gibi şeyleri A\l"
	.string "Düğmesiyle incele. {PLUS} Yön Tuşu'na basıp\l"
	.string "geçilmez görünen yerlere gitmeyi de\l"
	.string "dene.$"

Help_Text_AnswerOutOfThingsToDo::
	.string "Henüz gitmediğin yerlere gitmeyi dene.\n"
	.string "Ayrıca şüpheli görünen her şeyi A\l"
	.string "Düğmesine basarak incele.$"

Help_Text_AnswerWhatHappenedToItemIGot::
	.string "Başka bir karakterin sana verdiği her\n"
	.string "eşya ÇANTA'na girer. Eşya otomatik\l"
	.string "olarak sınıflandırılıp üç cepten birine\l"
	.string "konur. ÇANTA'nın kullanımı için lütfen\l"
	.string "YARDIM Sistemi'ndeki “Bunu nasıl\l"
	.string "yaparım?” başlığına bak.$"

Help_Text_AnswerWhatAreMyAdventureBasics::
	.string "POKéMON'lar savaşta yaralanırsa onları\n"
	.string "bir POKéMON MERKEZİ'ne götürüp\l"
	.string "görevlilere iyileştirt. Oyununu kaydedip\l"
	.string "ilerlemeni kaydetmeyi alışkanlık hâline\l"
	.string "getir. Uzağa gitmeden önce POKéMON\l"
	.string "MARKETLERİ'nden iyileştirici eşya\l"
	.string "stokla.$"

Help_Text_AnswerHowAreRoadsForestsDifferent::
	.string "Ormanlar temelde yollarla aynıdır ama\n"
	.string "labirent gibi olabilirler. Tüm ormanların\l"
	.string "bir çıkışı vardır, kaybolursan pes etme.$"

Help_Text_AnswerHowAreCavesDifferent::
	.string "Mağaralar karanlık ve tehlikelidir.\n"
	.string "Vahşi POKéMON'lar içlerinde her yerde\l"
	.string "çıkabilir. Acil bir durumda bir POKéMON\l"
	.string "MERKEZİ'ne koş ya da eşya kullan. Bazı\l"
	.string "mağaraların ötesinde keşfedilmeyi\l"
	.string "bekleyen yeni kasabalar var, pes etme.$"

Help_Text_AnswerHowDoIProgress::
	.string "Oyunun amacı POKéMON'larını eğitip\n"
	.string "ilerlemektir. Bilgi toplayıp sorunları\l"
	.string "çözmelisin. Örneğin bir engeli aşmak için\l"
	.string "neye ihtiyacın var? Yolu kesen o kişiyi\l"
	.string "ne kenara çeker?$"

Help_Text_AnswerWhenCanIUseItem::
	.string "Birkaç çeşit eşya vardır. Bazıları\n"
	.string "sadece sahada kullanılır. Bazıları\l"
	.string "sadece savaş sırasında kullanılır.\l"
	.string "Bazıları her zaman kullanılabilir. Bir\l"
	.string "eşyayı kullanmayı dene; kullanılamıyorsa\l"
	.string "uyarılırsın.$"

Help_Text_AnswerWhatsABattle::
	.string "Savaşta POKéMON'lar birbirlerinin HP ile\n"
	.string "ifade edilen canlılığını azaltmaya\l"
	.string "çalışır. Bir POKéMON'un HP'si sıfıra\l"
	.string "inerse bayılır ve diğer POKéMON kazanır.\l"
	.string "Savaş kazanan POKéMON'lar seviye\l"
	.string "atlamalarını (güçlenmelerini) sağlayan\l"
	.string "TP kazanır.$"

Help_Text_AnswerHowDoIPrepareForBattle::
	.string "Önce takımındaki (yanındaki) POKéMON'ları\n"
	.string "herhangi bir POKéMON MERKEZİ'nde\l"
	.string "tamamen iyileştir. Acil durumlar için bir\l"
	.string "POKéMON MARKET'ten iyileştirici eşyalar\l"
	.string "da almalısın.$"

Help_Text_AnswerWhatIsAMonsVitality::
	.string "POKéMON'un canlılığı HP ile ifade edilir.\n"
	.string "POKéMON savaşta yaralanırsa HP'si\l"
	.string "azalır. HP'si sıfıra inerse POKéMON\l"
	.string "bayılır. Yaralı ya da bayılmış\l"
	.string "POKéMON'ları bir POKéMON MERKEZİ'nde ya\l"
	.string "da eşya kullanarak iyileştir.$"

Help_Text_AnswerMyMonsAreHurt::
	.string "POKéMON MERKEZİ POKéMON'lar için bir\n"
	.string "han gibidir. Özel bir makineyle\l"
	.string "POKéMON'ları tüm durum sorunlarından\l"
	.string "kurtarır ve HP'lerini tamamen yeniler.\l"
	.string "Bu hizmet ücretsizdir, POKéMON'larını sık\l"
	.string "sık iyileştirmeyi alışkanlık edin.$"

Help_Text_AnswerWhatIsStatusProblem::
	.string "Durum sorunu, rakibin saldırısıyla\n"
	.string "POKéMON'a verilen bir rahatsızlıktır.\l"
	.string "Bunlar yanık, felç, zehirlenme, uyku ve\l"
	.string "donmadır. POKéMON MERKEZİ'ne giderek\l"
	.string "ya da uygun eşyayı kullanarak\l"
	.string "iyileştirilebilir.$"

Help_Text_AnswerWhatHappensIfAllMyMonsFaint::
	.string "Takımındaki (yanındaki) tüm POKéMON'lar\n"
	.string "bayılırsa biraz PARA kaybedersin ve eve\l"
	.string "ya da bir POKéMON MERKEZİ'ne geri\l"
	.string "dönersin. Bu ihtimali azaltmak için\l"
	.string "POKéMON MERKEZLERİ'ne sık uğra. Ayrıca\l"
	.string "sık sık kaydetmeyi alışkanlık edin.$"

Help_Text_AnswerCantCatchMons::
	.string "Vahşi bir POKéMON POKé TOPU'ndan\n"
	.string "kaçarsa belli ki hâlâ diridir. HP'sini\l"
	.string "biraz daha azaltmayı ve yakalamadan\l"
	.string "önce felç ya da uykuyla zayıflatmayı\l"
	.string "dene. POKé TOPU bir süre sallanırsa av\l"
	.string "yakalanmaya yakındır!$"

Help_Text_AnswerRanOutOfPotions::
	.string "Eşya satan, POKéMON MARKET adlı\n"
	.string "dükkânlar vardır. Yollarda, ormanlarda\l"
	.string "ya da mağaralarda POKéMON MARKET\l"
	.string "bulamazsın. POKéMON MARKET olan bir\l"
	.string "kasabadayken gereken eşyaları stokla.$"

Help_Text_AnswerCanIBuyPokeBalls::
	.string "POKé TOPU'nu her kasabadaki herhangi\n"
	.string "bir POKéMON MARKET'ten alabilirsin.\l"
	.string "Yollarda, ormanlarda ya da mağaralarda\l"
	.string "POKéMON MARKET bulamazsın. POKéMON\l"
	.string "MARKET olan bir kasabadayken POKé TOPU\l"
	.string "stokla.$"

Help_Text_AnswerWhatsATrainer::
	.string "EĞİTMEN, POKéMON'ları savaşarak\n"
	.string "yetiştiren kişidir. EĞİTMENLER nerede\l"
	.string "olurlarsa olsunlar sana meydan okur;\l"
	.string "bir yolda, ormanda, mağarada, her\l"
	.string "yerde olabilir. Göz göze gelirsen\l"
	.string "meydan okumalarını kabul etmelisin.\l"
	.string "Dikkatli ol!$"

Help_Text_AnswerHowDoIWinAgainstTrainer::
	.string "Bir EĞİTMENİ savaşta yenmek için rakibin\n"
	.string "POKéMON'larına karşı tür avantajı olan\l"
	.string "POKéMON'lar kullan. Ezici güce sahip,\l"
	.string "iyi eğitilmiş POKéMON'lar da\l"
	.string "kullanabilirsin. Rakipten daha çok\l"
	.string "POKéMON'a sahip olmak da bariz bir\l"
	.string "taktiktir.$"

Help_Text_AnswerWhereDoMonsAppear::
	.string "Vahşi POKéMON'lar uzun çimenlerde,\n"
	.string "yollarda ve ormanlarda ortaya çıkar.\l"
	.string "Karanlık mağaralarda her yerde\l"
	.string "çıkarlar. Kasabalarda vahşi POKéMON ya\l"
	.string "da EĞİTMEN yoktur, oralar güvenlidir.$"

Help_Text_AnswerWhatAreMoves::
	.string "POKéMON'lar en fazla dört farklı teknik,\n"
	.string "yani hareket öğrenebilir. Saldırılar ve\l"
	.string "özel etkili hareketler dahil çok çeşitli\l"
	.string "hareketler vardır. Öğrenilebilen\l"
	.string "hareketler her POKéMON için farklıdır.\l"
	.string "Bazı hareketler makinelerden\l"
	.string "öğrenilebilir.$"

Help_Text_AnswerWhatAreHiddenMoves::
	.string "GİZLİ hareketler, maceran için\n"
	.string "özellikle önemli olan hareketlerdir.\l"
	.string "Böyle bir hareketi savaş dışında\l"
	.string "kullanmak için “POKéMON” MENÜSÜ'nü aç\l"
	.string "ve hareketi bilen POKéMON'a kullandır.\l"
	.string "Bayılmış bir POKéMON da savaş dışında\l"
	.string "GİZLİ hareket kullanabilir.$"

Help_Text_AnswerWhatMovesShouldIUse::
	.string "“SAVAŞ”ı seç, hareket MENÜSÜ çıkar.\n"
	.string "Tür eşleşmelerini düşün ve en etkili\l"
	.string "hareketleri kullan. Hareketlerin\l"
	.string "etkilerini “POKéMON”u açıp bir POKéMON\l"
	.string "seçerek, “ÖZET”i ve ardından “POKéMON\l"
	.string "YETENEKLERİ”ni açarak görebilirsin.$"

Help_Text_AnswerWantToAddMoreMoves::
	.string "Bir POKéMON en fazla dört hareket\n"
	.string "öğrenebilir. Hareketler POKéMON seviye\l"
	.string "atladıkça öğrenilir. Bir POKéMON'a TM\l"
	.string "(Teknik Makine) ya da GM (Gizli Makine)\l"
	.string "ile de hareket öğretilebilir. Hareket\l"
	.string "öğreten insanlar da vardır.$"

Help_Text_AnswerWantToMakeMonStronger::
	.string "POKéMON'larını güçlendirmenin anahtarı\n"
	.string "sık sık savaşıp kazanmaktır. Kazanılan\l"
	.string "savaşlardan elde edilen TP (Tecrübe\l"
	.string "Puanı) birikir ve savaşa katılan\l"
	.string "POKéMON'ların seviye atlamasını sağlar.\l"
	.string "Takımının seviyesini yükseltmek için\l"
	.string "vahşi POKéMON'larla sık savaş.$"

Help_Text_AnswerFoeMonsTooStrong::
	.string "Rakiplerin çok güçlüyse POKéMON'larının\n"
	.string "seviyesini biraz daha yükseltmeyi dene.\l"
	.string "Geldiğin yoldan geri dön ve takımının\l"
	.string "seviyesini yükseltmek için vahşi\l"
	.string "POKéMON'larla savaş. Daha önce\l"
	.string "savaşmadığın EĞİTMENLERLE de\l"
	.string "savaşabilirsin.$"

Help_Text_AnswerWhatDoIDoInCave::
	.string "Yollar ve ormanların aksine mağaralarda\n"
	.string "vahşi POKéMON'lar her yerde çıkabilir.\l"
	.string "POKéMON'ların mağarada yaralanırsa\l"
	.string "hemen bir POKéMON MERKEZİ'ne koş ya da\l"
	.string "eşya kullanarak iyileştir. Mağaralarda\l"
	.string "şansını zorlamak çok tehlikelidir.$"

Help_Text_AnswerNothingIWantToKnow::
	.string "Kendi bilgine ve gücüne güven. Kendine\n"
	.string "inan ve yolunu bul!$"

Help_Text_AnswerWhatsPokemonCenter::
	.string "POKéMON MERKEZİ kırmızı çatısı ve “P.C”\n"
	.string "tabelasıyla tanınır. Her POKéMON\l"
	.string "MERKEZİ POKéMON'ları tamamen\l"
	.string "iyileştirme ve ücretsiz PC kullanımı gibi\l"
	.string "hizmetler sunar, bu yüzden\l"
	.string "yolculuğunda vazgeçilmezdir. Üst katta\l"
	.string "arkadaşlarla bağlantı kurma tesisleri\l"
	.string "vardır.$"

Help_Text_AnswerWhatsPokemonMart::
	.string "POKéMON MARKET mavi çatısı ve “MART”\n"
	.string "tabelasıyla tanınır. Her POKéMON\l"
	.string "MARKET'te eşya alınıp satılabilir. Bazı\l"
	.string "MARKETLERDE sadece o kasabada bulunan\l"
	.string "eşyalar vardır.$"

Help_Text_AnswerWantToEndGame::
	.string "MENÜ'de “KAYDET”i seçerek oyununu\n"
	.string "güvenle bitirebilirsin. Kaydettikten\l"
	.string "sonra oyun güvenle kapatılabilir. Oyun\l"
	.string "tekrar açıldığında en son kaydettiğin\l"
	.string "yerden devam edebilirsin.$"

Help_Text_AnswerWhatsAMon::
	.string "POKéMON'lar hakkında hâlâ pek çok gizem\n"
	.string "barındıran canlılardır. Onları\l"
	.string "çimenlerde, denizde ve mağaralarda\l"
	.string "görebilirsin. Onları yakalayan\l"
	.string "EĞİTMENLERİN isteklerine itaat ediyor\l"
	.string "gibi görünürler.$"

Help_Text_AnswerWhatIsThatPersonLike::
	.string "ÇANTA'ndaki ÖNEMLİ EŞYALAR arasındaki\n"
	.string "ÜNLÜ REHBERİ'ni kullan. Sana bir ipucu\l"
	.string "verebilir, bir dene.$"

Help_Text_AnswerWhatDoesHiddenMoveDo::
	.string "GİZLİ hareket bir POKéMON'a GM (Gizli\n"
	.string "Makine) ile öğretilir. GİZLİ hareket\l"
	.string "maceranda sana yardım etmesi açısından\l"
	.string "önemlidir. Örneğin biri karanlık\l"
	.string "mağaraları aydınlatır. Bir diğeri küçük\l"
	.string "ağaçları keser. Suda yolculuk etmek\l"
	.string "için de bir tane vardır.$"

Help_Text_AnswerWhatDoIDoInSafari::
	.string "Özel SAFARİ TOPLARI'nı atarak vahşi\n"
	.string "POKéMON yakalamaya çalış. Bulduğun her\l"
	.string "eşyayı da saklayabilirsin.$"

Help_Text_AnswerWhatAreSafariRules::
	.string "SAFARİ OYUNU'n belli bir mesafe\n"
	.string "yürüdüğünde ya da tüm SAFARİ\l"
	.string "TOPLARI'nı attığında biter. Kalan adım\l"
	.string "ve SAFARİ TOPU sayısını görmek için\l"
	.string "MENÜ'yü aç.$"

Help_Text_AnswerWantToEndSafari::
	.string "SAFARİ OYUNU'nu erken bitirmek istersen\n"
	.string "MENÜ'yü aç ve listenin en üstündeki\l"
	.string "“BIRAK”ı seç.$"

Help_Text_AnswerWhatIsAGym::
	.string "POKéMON SALONLARI POKéMON LİGİ\n"
	.string "tarafından işletilen EĞİTMEN eğitim\l"
	.string "tesisleridir. Ülkenin dört bir yanındaki\l"
	.string "şehir ve kasabalarda bulunurlar. Her\l"
	.string "birinin başında çok yetenekli bir\l"
	.string "EĞİTMEN olan bir LİDER vardır. ROZET\l"
	.string "kazanmak için LİDERİ yen.$"

