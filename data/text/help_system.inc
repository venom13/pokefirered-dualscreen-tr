Help_Text_HowToUsePokedex::
	.string "{CIRCLE_1} MENÜ'de “POKéDEX”i seç.\n"
	.string "{CIRCLE_2} “POKéMON LİSTESİ”, “POKéMON YAŞAM\n"
	.string "   ALANLARI” ve “ARAMA” gibi\n"
	.string "   komutlarla POKéMON seç.\n"
	.string "{CIRCLE_3} Ayrıntılı bilgi almak için bir POKéMON\n"
	.string "   seç.$"

Help_Text_HowToUsePokemon::
	.string "{CIRCLE_1} MENÜ'de “POKéMON”u seç.\n"
	.string "{CIRCLE_2} Takımından bir POKéMON seç.\n"
	.string "{CIRCLE_3} “ÖZET”, “DEĞİŞTİR” ya da “EŞYA”yı\n"
	.string "   seç.$"

Help_Text_HowToUseSummary::
	.string "{CIRCLE_1} “ÖZET”i seç.\n"
	.string "{CIRCLE_2} Bilgilere bakmak için {PLUS} Yön Tuşu'nda\n"
	.string "   sola ya da sağa bas:\n"
	.string "   “POKéMON BİLGİSİ”\n"
	.string "   “POKéMON YETENEKLERİ”\n"
	.string "   “BİLDİĞİ HAREKETLER”$"

Help_Text_HowToUseSwitch::
	.string "{CIRCLE_1} Yerini değiştirmek istediğin POKéMON'u\n"
	.string "   seç.\n"
	.string "{CIRCLE_2} “DEĞİŞTİR”i seç.\n"
	.string "{CIRCLE_3} İlkiyle yer değiştirecek POKéMON'u\n"
	.string "   seç.\n"
	.string "Ekranın solundaki POKéMON savaşa ilk\n"
	.string "çıkan olur.$"

Help_Text_HowToUseItem::
	.string "{CIRCLE_1} “EŞYA”yı seç.\n"
	.string "{CIRCLE_2} POKéMON'a tutması için eşya “VER”mek\n"
	.string "   mi yoksa tuttuğu eşyayı “AL”mak mı\n"
	.string "   istediğini seç.\n"
	.string "Bir POKéMON en fazla bir eşya\n"
	.string "tutabilir!$"

Help_Text_HowToUseBag::
	.string "{CIRCLE_1} MENÜ'de “ÇANTA”yı seç.\n"
	.string "{CIRCLE_2} Bölümler için {PLUS} Yön Tuşu'nda sola ya da\n"
	.string "   sağa bas:\n"
	.string "   “EŞYALAR”\n"
	.string "   “ÖNEMLİ EŞYA”\n"
	.string "   “POKé TOPLARI”\n"
	.string "   Yukarı/aşağı ile eşya seç.$"

Help_Text_HowToUseAnItem::
	.string "{CIRCLE_1} “EŞYALAR” CEBİ'ni seç.\n"
	.string "{CIRCLE_2} Eşya seçmek için {PLUS} Yön Tuşu'nda yukarı\n"
	.string "   ya da aşağı bas.\n"
	.string "{CIRCLE_3} Seçili eşyayı kullanmak için “KULLAN”ı\n"
	.string "   seç.\n"
	.string "Bazı eşyalar yere ya da duruma göre\n"
	.string "kullanılamayabilir.$"

Help_Text_HowToUseKeyItem::
	.string "{CIRCLE_1} “ÖNEMLİ EŞYA” CEBİ'ni seç.\n"
	.string "{CIRCLE_2} Önemli eşya seçmek için {PLUS} Yön Tuşu'nda\n"
	.string "   yukarı ya da aşağı bas.\n"
	.string "{CIRCLE_3} Seçili önemli eşyayı kullanmak için\n"
	.string "   “KULLAN”ı seç.$"

Help_Text_HowToUsePokeBall::
	.string "{CIRCLE_1} Vahşi bir POKéMON'la savaşırken\n"
	.string "   ÇANTA'nın “POKé TOPLARI” CEBİ'ni\n"
	.string "   seç.\n"
	.string "{CIRCLE_2} POKé TOPU seçmek için {PLUS} Yön Tuşu'nda\n"
	.string "   yukarı ya da aşağı bas.\n"
	.string "{CIRCLE_3} Seçili POKé TOPU'nu atmak için\n"
	.string "   “KULLAN”ı seç.$"

Help_Text_HowToUsePlayer::
	.string "{CIRCLE_1} MENÜ'de “{PLAYER}”ı seç.\n"
	.string "{CIRCLE_2} EĞİTMEN KARTI'n temel bilgilerle ön\n"
	.string "   yüzü açık gösterilir. KARTI çevirmek\n"
	.string "   için A Düğmesine bas.\n"
	.string "{CIRCLE_3} KARTIN arka yüzünde çeşitli veriler\n"
	.string "   bulunur.$"

Help_Text_HowToUseSave::
	.string "{CIRCLE_1} MENÜ'de “KAYDET”i seç.\n"
	.string "{CIRCLE_2} “EVET”i seçince ilerlemen kayıt\n"
	.string "   dosyasına kaydedilir.\n"
	.string "Oyun kaydedildikten sonra oyunu\n"
	.string "kapatabilirsin. Oyuna kaydettiğin yerden\n"
	.string "devam edebilirsin.$"

Help_Text_HowToUseOption::
	.string "{CIRCLE_1} MENÜ'de “AYARLAR”ı seç.\n"
	.string "{CIRCLE_2} Bir ayar seçmek için {PLUS} Yön Tuşu'nda\n"
	.string "   yukarı ya da aşağı, ayarı\n"
	.string "   değiştirmek için sola ya da sağa\n"
	.string "   bas.\n"
	.string "{CIRCLE_3} Değişikliklerden sonra “VAZGEÇ”i seç\n"
	.string "   ya da B Düğmesine bas.$"

Help_Text_HowToUsePotion::
	.string "{CIRCLE_1} MENÜ'yü aç.\n"
	.string "{CIRCLE_2} {PLUS} Yön Tuşu'nda yukarı ya da aşağı basıp\n"
	.string "   “ÇANTA”yı seç.\n"
	.string "{CIRCLE_3} “EŞYALAR” CEBİ'nde “İKSİR”i seç.\n"
	.string "{CIRCLE_4} “KULLAN”ı seç.\n"
	.string "{CIRCLE_5} İyileştirilecek POKéMON'u seç.$"

Help_Text_HowToUseTownMap::
	.string "{CIRCLE_1} MENÜ'yü aç.\n"
	.string "{CIRCLE_2} {PLUS} Yön Tuşu ile “ÇANTA”yı seç.\n"
	.string "{CIRCLE_3} Sola/sağa basıp “ÖNEMLİ EŞYA” CEBİ'ni\n"
	.string "   aç, yukarı/aşağı ile “KENT\n"
	.string "   HARİTASI”nı seç.\n"
	.string "{CIRCLE_4} KENT HARİTASI'nı açmak için “KULLAN”ı\n"
	.string "   seç.$"

Help_Text_HowToUseTM::
	.string "{CIRCLE_1} MENÜ'yü aç.\n"
	.string "{CIRCLE_2} “ÇANTA”daki “ÖNEMLİ EŞYA” CEBİ'ni aç.\n"
	.string "{CIRCLE_3} TM KUTUSU'nu “AÇ”.\n"
	.string "{CIRCLE_4} Bir TM seç ve “KULLAN”.\n"
	.string "{CIRCLE_5} TM'deki hareketi öğrenebilen bir\n"
	.string "   POKéMON seç.$"

Help_Text_HowToUseHM::
	.string "{CIRCLE_1} MENÜ'yü aç.\n"
	.string "{CIRCLE_2} “ÇANTA”daki “ÖNEMLİ EŞYA” CEBİ'ni aç.\n"
	.string "{CIRCLE_3} TM KUTUSU'nu “AÇ”.\n"
	.string "{CIRCLE_4} Bir GM seç ve “KULLAN”.\n"
	.string "{CIRCLE_5} Onu öğrenebilen bir POKéMON seç.\n"
	.string "GM'ler zor silinir, dikkatli ol!$"

Help_Text_HowToUseMoveOutsideOfBattle::
	.string "{CIRCLE_1} MENÜ'yü aç.\n"
	.string "{CIRCLE_2} “POKéMON”u seç.\n"
	.string "{CIRCLE_3} GM hareketi bilen bir POKéMON seç.\n"
	.string "   Kullanılabilir GM hareketleri mavi\n"
	.string "   gösterilir. Engel yıkmak, uçmak, sörf\n"
	.string "   yapmak gibi işler için istenen\n"
	.string "   hareketi seçip kullan.$"

Help_Text_HowToRideBicycle::
	.string "{CIRCLE_1} MENÜ'yü aç. “ÇANTA”daki “ÖNEMLİ\n"
	.string "   EŞYA” CEBİ'ni aç ve “BİSİKLET”i\n"
	.string "   seç.\n"
	.string "{CIRCLE_2} “KULLAN”ı seçerek BİSİKLET'e\n"
	.string "   binebilirsin. SELECT'e basarak hemen\n"
	.string "   kullanmak için “KAYDET” de\n"
	.string "   edebilirsin.$"

Help_Text_HowToEnterName::
	.string "{CIRCLE_1} İmleci {PLUS} Yön Tuşu ile istediğin harfe\n"
	.string "   götür, girmek için A Düğmesine bas.\n"
	.string "{CIRCLE_2} Silmek için B Düğmesine bas.\n"
	.string "{CIRCLE_3} Büyük ve küçük harf arasında geçiş\n"
	.string "   için SELECT'e bas.\n"
	.string "{CIRCLE_4} “TAMAM” üzerinde A Düğmesine bas.$"

Help_Text_HowToUsePC::
	.string "{CIRCLE_1} Herhangi bir POKéMON MERKEZİ'ne git,\n"
	.string "   PC'nin yanına gidip A Düğmesine bas.$"

Help_Text_HowToUseBillsPC::
	.string "{CIRCLE_1} PC'de “{STR_VAR_1}” PC'sini seç.\n"
	.string "{CIRCLE_2} POKéMON Depolama Sistemi için üstteki\n"
	.string "   üç MENÜ öğesinden birini seç.\n"
	.string "Takımında altı POKéMON varken\n"
	.string "yakaladığın POKéMON otomatik olarak\n"
	.string "Sistemdeki bir KUTU'ya gider!$"

Help_Text_HowToUseWithdraw::
	.string "{CIRCLE_1} Açık KUTU'daki bir POKéMON'u {PLUS} Yön Tuşu\n"
	.string "   ile seç.\n"
	.string "{CIRCLE_2} POKéMON'u KUTU'dan alıp takımına\n"
	.string "   eklemek için “ÇEK”i seç.\n"
	.string "Yanında zaten altı POKéMON varsa\n"
	.string "POKéMON çekemezsin!$"

Help_Text_HowToUseDeposit::
	.string "{CIRCLE_1} Takımındaki bir POKéMON'u {PLUS} Yön Tuşu ile\n"
	.string "   seç.\n"
	.string "{CIRCLE_2} “YATIR”ı seç.\n"
	.string "{CIRCLE_3} KUTU'yu seç, POKéMON'u depolamak için\n"
	.string "   A Düğmesine bas.\n"
	.string "Yanında sadece bir POKéMON varsa\n"
	.string "depolanamaz!$"

Help_Text_HowToUseMove::
	.string "{CIRCLE_1} Açık KUTU'daki bir POKéMON'u seç.\n"
	.string "{CIRCLE_2} “TAŞI”yı seçerek POKéMON'u al ve {PLUS} Yön\n"
	.string "   Tuşu ile istediğin yere taşı.\n"
	.string "{CIRCLE_3} POKéMON'u KUTU adının üstüne getir ve\n"
	.string "   başka bir KUTU'ya taşımak için sola\n"
	.string "   ya da sağa bas.$"

Help_Text_HowToMoveItems::
	.string "{CIRCLE_1} Soluk gösterilen POKéMON'u seçip A\n"
	.string "   Düğmesine basarak ona eşya\n"
	.string "   tutturabilirsin.\n"
	.string "{CIRCLE_2} Net gösterilen POKéMON tuttuğu eşyayı\n"
	.string "   A Düğmesiyle başka bir POKéMON'a\n"
	.string "   verebilir ya da ÇANTA'ya geri\n"
	.string "   koyabilir.$"

Help_Text_HowToUsePlayersPC::
	.string "{CIRCLE_1} PC'de “PC: {PLAYER}”ı seç.\n"
	.string "{CIRCLE_2} “EŞYA DEPOSU” ya da “POSTA\n"
	.string "   KUTUSU”nu seç.\n"
	.string "ÇANTA'n doluysa kendi PC'nde eşya\n"
	.string "depolayabilirsin. PC'nde depolanan\n"
	.string "eşyaları da çekebilirsin.$"

Help_Text_HowToUseWithdrawItem::
	.string "{CIRCLE_1} “EŞYA ÇEK”i seç.\n"
	.string "{CIRCLE_2} Çekilecek eşyayı seç.\n"
	.string "{CIRCLE_3} Eşya çekilip ÇANTA'nın EŞYALAR CEBİ'ne\n"
	.string "   konabilir. Doğrudan bir POKéMON'a\n"
	.string "   tutması için de verilebilir.$"

Help_Text_HowToUseDepositItem::
	.string "{CIRCLE_1} “EŞYA YATIR”ı seç.\n"
	.string "{CIRCLE_2} Yatırılacak eşyayı ÇANTA'dan {PLUS} Yön Tuşu\n"
	.string "   ile seç.\n"
	.string "{CIRCLE_3} Yatırılacak birden fazla eşya varsa\n"
	.string "   miktarı {PLUS} Yön Tuşu ile gir, sonra A\n"
	.string "   Düğmesine bas.$"

Help_Text_HowToUseMailbox::
	.string "POKéMON'dan alınan MEKTUP POSTA\n"
	.string "KUTUSU'na konur. MEKTUP yoksa POSTA\n"
	.string "KUTUSU kullanılmaz.\n"
	.string "{CIRCLE_1} PC'de “PC: {PLAYER}”ı seç.\n"
	.string "{CIRCLE_2} MEKTUP okumak ya da tutturmak için\n"
	.string "   “POSTA KUTUSU”nu seç.$"

Help_Text_HowToUseProfOaksPC::
	.string "{CIRCLE_1} PC'de “PROF. OAK'IN PC'Sİ”ni seç.\n"
	.string "{CIRCLE_2} PROF. OAK POKéDEX'ini değerlendirir.\n"
	.string "Değerlendirmeleri daha çok POKéMON\n"
	.string "yakalaman için ipucu verir!$"

Help_Text_HowToOpenMenu::
	.string "{CIRCLE_1} START'a bas.\n"
	.string "{CIRCLE_2} MENÜ sağda açılır.\n"
	.string "{CIRCLE_3} Duruma göre MENÜ'de farklı başlıklar\n"
	.string "   olabilir.\n"
	.string "Konuşurken, bir şey yaparken, savaşırken\n"
	.string "gibi bazı durumlarda MENÜ açılmaz.$"

Help_Text_HowToUseFight::
	.string "{CIRCLE_1} “SAVAŞ”ı seç.\n"
	.string "{CIRCLE_2} Gösterilen hareketlerden birini seç, o\n"
	.string "   hareket kullanılır!$"

Help_Text_HowToUsePokemon2::
	.string "{CIRCLE_1} “POKéMON”u seç.\n"
	.string "{CIRCLE_2} Takımından kullanmak istediğin\n"
	.string "   POKéMON'u seç.\n"
	.string "{CIRCLE_3} Yanında iki ya da daha çok POKéMON\n"
	.string "   varsa “DEĞİŞ” ile değiştirebilirsin.\n"
	.string "   “ÖZET” ile POKéMON verilerine bak.$"

Help_Text_HowToUseShift::
	.string "Bu komut savaştaki POKéMON'u takımındaki\n"
	.string "başka biriyle değiştirir.\n"
	.string "{CIRCLE_1} Gönderilecek POKéMON'u seç.\n"
	.string "{CIRCLE_2} “DEĞİŞ”i seç.\n"
	.string "{CIRCLE_3} Seçilen POKéMON savaştaki POKéMON'la\n"
	.string "   yer değiştirir!$"

Help_Text_HowToUseSummary2::
	.string "{CIRCLE_1} “ÖZET”i seç.\n"
	.string "{CIRCLE_2} Bilgilere bakmak için {PLUS} Yön Tuşu'nda\n"
	.string "   sola ya da sağa bas:\n"
	.string "   “POKéMON BİLGİSİ”\n"
	.string "   “POKéMON YETENEKLERİ”\n"
	.string "   “BİLDİĞİ HAREKETLER”$"

Help_Text_HowToUseBag2::
	.string "{CIRCLE_1} “ÇANTA”yı seç.\n"
	.string "{CIRCLE_2} Bölümler için {PLUS} Yön Tuşu'nda sola ya da\n"
	.string "   sağa bas:\n"
	.string "   “EŞYALAR”\n"
	.string "   “ÖNEMLİ EŞYA”\n"
	.string "   “POKé TOPLARI”\n"
	.string "   Yukarı/aşağı ile eşya seç.$"

Help_Text_HowToReadPokedex::
	.string "{CIRCLE_1} Yakaladığın POKéMON'lar POKéDEX\n"
	.string "   listesinde POKé TOPU işaretiyle\n"
	.string "   gösterilir.\n"
	.string "{CIRCLE_2} Yakalanan bir POKéMON çok fazla veri\n"
	.string "   sağlar.\n"
	.if REVISION < 1
	.string "{CIRCLE_3} POKéMON'un yaşam alanlarını KENT\n"
	.string "   HARİTASI'nda görmek için “BÖLGE”yi\l"
	.string "   seç.$"
	.else
	.string "{CIRCLE_3} Yaşam alanlarını KENT HARİTASI'nda\n"
	.string "   görmek için “SONRAKİ”yi seç.$"
	.endif

Help_Text_HowToUseHomePC::
	.string "{CIRCLE_1} Evdeki PC'nin yanına git ve A Düğmesine\n"
	.string "   bas.\n"
	.string "{CIRCLE_2} PC açılır.\n"
	.string "{CIRCLE_3} “EŞYA DEPOSU” ya da “POSTA\n"
	.string "   KUTUSU”nu seç.$"

Help_Text_HowToUseItemStorage::
	.string "{CIRCLE_1} PC'nde depolanan bir eşyayı çekmek için\n"
	.string "   “EŞYA ÇEK”i seç.\n"
	.string "{CIRCLE_2} ÇANTA'ndaki bir eşyayı PC'ne koymak\n"
	.string "   için “EŞYA YATIR”ı seç.$"

Help_Text_HowToUseWithdrawItem2::
	.string "{CIRCLE_1} “EŞYA ÇEK”i seç.\n"
	.string "{CIRCLE_2} Çekilecek eşyayı seç.\n"
	.string "{CIRCLE_3} Eşya çekilip ÇANTA'nın EŞYALAR CEBİ'ne\n"
	.string "   konabilir. Doğrudan bir POKéMON'a\n"
	.string "   tutması için de verilebilir.$"

Help_Text_HowToUseDepositItem2::
	.string "{CIRCLE_1} “EŞYA YATIR”ı seç.\n"
	.string "{CIRCLE_2} Yatırılacak eşyayı ÇANTA'dan {PLUS} Yön Tuşu\n"
	.string "   ile seç.\n"
	.string "{CIRCLE_3} ÇANTA'da hiçbir şey yoksa bu komut\n"
	.string "   kullanılamaz!$"

Help_Text_HowToUseMailbox2::
	.string "POKéMON'dan alınan MEKTUP POSTA\n"
	.string "KUTUSU'na konur. MEKTUP yoksa POSTA\n"
	.string "KUTUSU kullanılamaz.\n"
	.string "{CIRCLE_1} Okumak ya da POKéMON'a tutturmak için\n"
	.string "   MEKTUBU adından seç.$"

Help_Text_HowToUseRun::
	.string "EĞİTMEN savaşından “KAÇ”amazsın!\n"
	.string "{CIRCLE_1} Vahşi bir POKéMON'dan “KAÇ”abilirsin.\n"
	.string "{CIRCLE_2} Savaştaki POKéMON'un hızlıysa kaçma\n"
	.string "   şansın artar.$"

Help_Text_HowToRegisterKeyItem::
	.string "SELECT'e basarak hemen kullanmak için\n"
	.string "önemli bir eşyayı “KAYDET”ebilirsin!\n"
	.string "{CIRCLE_1} “ÖNEMLİ EŞYA” CEBİ'ni aç.\n"
	.string "{CIRCLE_2} Önemli eşyayı seç, sonra “KAYDET”i\n"
	.string "   seç.$"

Help_Text_HowToUseBall::
	.string "{CIRCLE_1} Sadece SAFARİ BÖLGESİ'nde kullanılan\n"
	.string "   özel POKé TOPU'nu atmak için seç.\n"
	.string "Vahşi POKéMON çıkınca onları yakalamak\n"
	.string "için bol bol SAFARİ TOPU at!$"

Help_Text_HowToUseBait::
	.string "{CIRCLE_1} Sadece SAFARİ BÖLGESİ'nde kullanılan\n"
	.string "   özel yemi atmak için seç.\n"
	.string "Kolay yenmesi için top hâline getirilmiş\n"
	.string "POKéMON yemidir. YEM atılınca vahşi\n"
	.string "POKéMON ona ilgi duyup kaçmayabilir!$"

Help_Text_HowToUseRock::
	.string "{CIRCLE_1} SAFARİ BÖLGESİ'nde yerde duran bir\n"
	.string "   taşı atmak için seç.\n"
	.string "POKéMON'a taş atmak kaçmasına yol\n"
	.string "açabilir ama yakalamak kolaylaşır!$"

Help_Text_HowToUseHallOfFame::
	.string "{CIRCLE_1} PC'de “ŞÖHRET SALONU”nu seç.\n"
	.string "{CIRCLE_2} ŞÖHRET SALONU'na giren POKéMON'lar\n"
	.string "   incelenebilir.$"

