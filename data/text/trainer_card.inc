CeladonCity_GameCorner_Text_TryPokemonPrinter::
	.string "Bu bir POKéMON YAZICISI!\p"
	.string "EĞİTMEN KARTI'nın arkasına POKéMON'unun\n"
	.string "resmini basabilir.\p"
	.string "Ücreti yalnızca ¥50.\n"
	.string "Denemek ister misin?$"

CeladonCity_GameCorner_Text_DontHaveEnoughMoney::
	.string "Yeterli paran yok.$"

CeladonCity_GameCorner_Text_ChoosePrintType::
	.string "Lütfen baskı türünü seç.$"

CeladonCity_GameCorner_Text_BigSmileForPhoto::
	.string "Fotoğraf için kocaman bir gülümseme\n"
	.string "lütfen!\l"
	.string "Üç… İki… Bir…\p"
	.string "Flaş!$"

CeladonCity_GameCorner_Text_PrintIsReadyCheckTrainerCard::
	.string "POKéMON baskın hazır!\n"
	.string "EĞİTMEN KARTI'na bak.$"

FourIsland_House2_Text_WishICouldShowOffStickers::
	.string "Kıkır kıkır…\n"
	.string "Bir ton ÇIKARTMA topladım.\l"
	.string "Keşke onları gösterebilsem…$"

FourIsland_House2_Text_GiveYouStickerIfYouBrag::
	.string "Oh, harika!\n"
	.string "Doğru yere geldin!\p"
	.string "Bak, bak! Gördün mü? Gördün mü?\n"
	.string "Bunlar benim ÇIKARTMALARIM!\l"
	.string "Bak ne kadar çok var!\p"
	.string "Eminim sen de biraz istersin.\n"
	.string "Eminim istersin!\p"
	.string "Bana kendinle ilgili müthiş bir şey\n"
	.string "anlatırsan sana bir ÇIKARTMA veririm.\p"
	.string "Neyle hava atacaksın?$"

FourIsland_House2_Text_BragAboutSomethingForMe::
	.string "Bana bir şeyle hava at.\n"
	.string "Sana bir ÇIKARTMA vereyim.$"

FourIsland_House2_Text_BragAboutWhatToday::
	.string "Oh, selam!\n"
	.string "İşte geldi bizim övüngen.\p"
	.string "Bugün neyle hava atacaksın?$"

FourIsland_House2_Text_WowHoFLowest::
	.string "Vay, ŞÖHRET SALONU'na girmişsin.\p"
	.string "Fena değil, evet!\n"
	.string "Sana bunlardan birini vereyim.$"

FourIsland_House2_Text_WowHoFLow::
	.string "Vay, ŞÖHRET SALONU'na sık sık\n"
	.string "girmişsin!\p"
	.string "Etkileyici, evet!\n"
	.string "Sana bunlardan birini vereyim.$"

FourIsland_House2_Text_WowHoFHigh::
	.string "Vay! ŞÖHRET SALONU'na bu kadar sık mı\n"
	.string "girdin?\l"
	.string "Cidden inanılmaz, evet!\p"
	.string "POKéMON LİGİ senin çöplüğün!\n"
	.string "Sana bunlardan birini vereyim.$"

FourIsland_House2_Text_WowHoFHighest::
	.string "Olamaz! ŞÖHRET SALONU'na bu kadar çok\n"
	.string "mu girdin?\p"
	.string "Sen inanılmazın da ötesindesin, evet!\n"
	.string "Tamam, bunu sana vermek zorundayım.$"

FourIsland_House2_Text_HoFStickerApplied::
	.string "ŞÖHRET SALONU ÇIKARTMASI EĞİTMEN\n"
	.string "KARTI'na yapıştırıldı.$"

FourIsland_House2_Text_ComeBackWithBetterStoryHoF::
	.string "Hımm…\p"
	.string "Bir dahaki sefere daha iyi bir\n"
	.string "hikâyeyle gel, olur mu?$"

FourIsland_House2_Text_LivingLegendHoF::
	.string "Ah, hayır, olmaz.\p"
	.string "Sen neredeyse yaşayan bir efsanesin.\n"
	.string "Verecek ÇIKARTMAM kalmadı.$"

FourIsland_House2_Text_WowEggsLowest::
	.string "Vay, POKéMON YUMURTALARI mı var?\n"
	.string "Bunu bilmiyordum!\p"
	.string "Fena değil, evet!\n"
	.string "Sana bunlardan birini vereyim.$"

FourIsland_House2_Text_WowEggsLow::
	.string "O kadar çok YUMURTA mı çatlattın?\n"
	.string "Onları gerçekten seviyor olmalısın!\p"
	.string "Etkileyici, evet!\n"
	.string "Sana bunlardan birini vereyim.$"

FourIsland_House2_Text_WowEggsHigh::
	.string "Vay! Bir sürü YUMURTA çatlatmışsın!\p"
	.string "Sen bir YUMURTA çatlatma makinesisin!\n"
	.string "Sana bunlardan birini vereyim.$"

FourIsland_House2_Text_WowEggsHighest::
	.string "N… O kadar çok YUMURTA mı çatlattın?\p"
	.string "Bu YUMURTA sevgisinin ardında ne var?\n"
	.string "İnanılmazın da ötesinde, evet!\p"
	.string "Sen çok müthişsin, söyleyeyim.\n"
	.string "Tamam, bunu sana vermek zorundayım.$"

FourIsland_House2_Text_EggStickerApplied::
	.string "YUMURTA ÇIKARTMASI EĞİTMEN KARTI'na\n"
	.string "yapıştırıldı.$"

