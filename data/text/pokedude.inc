Pokedude_Text_SpeedierBattlerGoesFirst::
	.string "POKé ADAM: Savaşanlardan hızlı olan\n"
	.string "önce saldırır.$"

Pokedude_Text_MyRattataFasterThanPidgey::
	.string "Görünüşe göre RATTATA'm PIDGEY'den\n"
	.string "hızlıymış.$"

Pokedude_Text_BattlersTakeTurnsAttacking::
	.string "Savaşanlar sırayla saldırıp birbirlerinin\n"
	.string "HP'sini azaltır.$"

Pokedude_Text_MyRattataWonGetsEXP::
	.string "RATTATA'm rakibin HP'sini sıfıra indirdi,\n"
	.string "yani kazandı!\p"
	.string "Savaşa katılan POKéMON'lar TP kazanır.\p"
	.string "Bir POKéMON yeterince TP toplayınca\n"
	.string "seviye atlar.\p"
	.string "Seviye atlamak POKéMON'unu öncekinden\n"
	.string "güçlü yapar.$"

Pokedude_Text_UhOhRattataPoisoned::
	.string "POKé ADAM: Eyvah…\n"
	.string "RATTATA'm zehirlendi…\p"
	.string "Zehirlenen POKéMON sürekli HP\n"
	.string "kaybeder.$"

Pokedude_Text_HealStatusRightAway::
	.string "Bir POKéMON'da durum sorunu çıkarsa\n"
	.string "hemen iyileştir.$"

Pokedude_Text_UsingItemTakesTurn::
	.string "Ama POKéMON'a eşya kullanmak bir tur\n"
	.string "harcar.\p"
	.string "Şimdi sıra rakipte!$"

Pokedude_Text_YayWeManagedToWin::
	.string "Yaşasın!\n"
	.string "Kazanmayı başardık!$"

Pokedude_Text_WaterNotVeryEffectiveAgainstGrass::
	.string "POKé ADAM: BALONCUK hareketi SU türü\n"
	.string "bir saldırıdır.\p"
	.string "Hedefteki ODDISH, ÇİMEN/ZEHİR türü\n"
	.string "bir POKéMON.\p"
	.string "SU türü saldırı ÇİMEN türü POKéMON\n"
	.string "tarafından emilir…\p"
	.string "Sonuç olarak hareket pek etkili olmaz\n"
	.string "ve normal hasarın yalnızca yarısını\l"
	.string "verir.$"

Pokedude_Text_GrassEffectiveAgainstWater::
	.string "Eyvah, bu iyi değil!\p"
	.string "Az önce gördüğün EMME saldırısı ÇİMEN\n"
	.string "türü bir harekettir.\p"
	.string "POLIWAG ise SU türü bir POKéMON.\p"
	.string "Yani EMME süper etkili olur ve hasarı\n"
	.string "ikiye katlar.$"

Pokedude_Text_LetsTryShiftingMons::
	.string "Bu eşleşmeyle kazanmak kolay\n"
	.string "olmayacak…\p"
	.string "POKéMON değiştirmeyi deneyelim!$"

Pokedude_Text_ShiftingUsesTurn::
	.string "POKéMON değiştirmek bir tur harcar.\p"
	.string "Şimdi sıra rakipte.$"

Pokedude_Text_ButterfreeDoubleResistsGrass::
	.string "BUTTERFREE, BÖCEK/UÇAN türü bir\n"
	.string "POKéMON.\p"
	.string "Bu POKéMON'a karşı ÇİMEN türü bir\n"
	.string "saldırı…\p"
	.string "…BÖCEK türü POKéMON'a normal hasarın\n"
	.string "yalnızca yarısını verir…\p"
	.string "…Ve UÇAN türü POKéMON'a da hasarın\n"
	.string "yalnızca yarısını verir.\p"
	.string "Bu yüzden BÖCEK/UÇAN olan BUTTERFREE\n"
	.string "normal hasarın yalnızca dörtte birini\l"
	.string "alır.$"

Pokedude_Text_ButterfreeGoodAgainstOddish::
	.string "ODDISH, ÇİMEN/ZEHİR türü bir POKéMON.\p"
	.string "UÇAN ya da PSİŞİK türü saldırı ona\n"
	.string "karşı süper etkilidir.\p"
	.string "Bu türlerden bir saldırı normal hasarın\n"
	.string "iki katını verir.\p"
	.string "Tamam, başlıyoruz!$"

Pokedude_Text_YeahWeWon::
	.string "Evet!\n"
	.string "Kazandık!$"

Pokedude_Text_WeakenMonBeforeCatching::
	.string "POKé ADAM: Bir POKéMON yakalamaya\n"
	.string "çalışırken hemen POKé TOPU atma.\p"
	.string "Önce HP'sini azaltarak onu\n"
	.string "zayıflatmalısın.$"

Pokedude_Text_BestIfTargetStatused::
	.string "Tamam, bu kadarı yeterli olmalı.\p"
	.string "Ama mümkünse hedefin bir durum sorunu\n"
	.string "olması en iyisi.\p"
	.string "Örneğin uykuda ya da felçli olsaydı\n"
	.string "yakalaması daha kolay olurdu.$"

Pokedude_Text_CantDoubleUpOnStatus::
	.string "Bu, POKéMON'u yakalamayı çok\n"
	.string "kolaylaştırır!\p"
	.string "Ah, evet. Bir POKéMON'u felç edersen\n"
	.string "üstüne bir de uyutamazsın.\p"
	.string "Yani durum sorunlarını üst üste\n"
	.string "bindiremezsin, tamam mı?$"

Pokedude_Text_LetMeThrowBall::
	.string "Tamam!\n"
	.string "Şimdi POKé TOPUMU atayım!$"

Pokedude_Text_PickBestKindOfBall::
	.string "POKé TOPU atmadan önce POKéMON'un\n"
	.string "durumunu ve türünü düşün, en iyi işe\l"
	.string "yarayacak TOP çeşidini seç.$"
